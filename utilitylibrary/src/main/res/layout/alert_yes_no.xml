<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:jp="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/colorPrimary"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_margin="10dp"
        android:padding="2dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="10dp"
            android:src="@drawable/ic_baseline_settings_power_24"
            android:visibility="gone"
            jp:layout_constraintEnd_toEndOf="parent"
            jp:layout_constraintStart_toStartOf="parent"
            jp:layout_constraintTop_toTopOf="parent" />

        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:id="@+id/title_dtxv"
            android:layout_width="match_parent"

            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp"
            android:gravity="center"
            android:text="Alert heading"
            android:textColor="@color/white"
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            jp:layout_constraintEnd_toEndOf="parent"
            jp:layout_constraintStart_toStartOf="parent"
            jp:layout_constraintTop_toBottomOf="@id/image" />

        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:id="@+id/desc_dtxv"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:layout_below="@+id/title_dtxv"
            android:layout_margin="10dp"
            android:gravity="center"
            android:maxLines="5"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/sp14"
            jp:layout_constraintEnd_toEndOf="parent"
            jp:layout_constraintStart_toStartOf="parent"
            jp:layout_constraintTop_toBottomOf="@id/title_dtxv" />
        <!-- <Te
             android:id="@+id/anot_edt"
             android:layout_width="match_parent"
             android:layout_height="200dp"
             android:layout_below="@+id/title_dtxv"
             android:layout_marginBottom="10dp"
             android:layout_marginLeft="10dp"
             android:layout_marginRight="10dp"
             android:layout_marginTop="5dp"
             android:background="@color/white"
             android:gravity="start"
             android:maxLines="4"
             android:padding="10dp"
             android:text=""
             android:textColor="@color/fluid_black" />-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_margin="10dp"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="2"


            jp:layout_constraintBottom_toBottomOf="parent"
            jp:layout_constraintEnd_toEndOf="parent"
            jp:layout_constraintTop_toBottomOf="@id/desc_dtxv">

            <com.pacifyrapp.utilitylibrary.CustomFontTextView
                android:id="@+id/dismis_dtxv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"


                android:layout_marginRight="5dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="No"
                android:textColor="@color/white"
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                jp:percentage_width="20" />


            <com.pacifyrapp.utilitylibrary.CustomFontTextView
                android:id="@+id/ok_dtxv"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"

                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="Yes"
                android:textColor="@color/white"
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                jp:percentage_width="20" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>