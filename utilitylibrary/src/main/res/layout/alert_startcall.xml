<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:jp="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CustomNoActionBarTheme"
    android:layout_height="wrap_content"
    android:background="@drawable/white_round_square"
    android:padding="2dp">

<LinearLayout

    android:layout_width="match_parent"
    android:padding="10dp"
    android:layout_centerInParent="true"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            android:text="Connect to Provider"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:id="@+id/connectTo"
            android:layout_marginLeft="8dp" />

        <com.pacifyrapp.utilitylibrary.DeviceFitImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:width_percentage="9"
           app:parameter="aspect_width"
            android:id="@+id/close_dimv"
            android:scaleType="fitXY"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_clear_black_24dp"
            android:layout_alignParentRight="true" />

    </RelativeLayout>

    <com.pacifyrapp.utilitylibrary.CustomFontTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="3dp"
        android:id="@+id/pacifyr_call_intro"
        android:visibility="gone"
        android:gravity="left"
        android:layout_gravity="left"
        android:layout_marginBottom="3dp"
        ></com.pacifyrapp.utilitylibrary.CustomFontTextView>


<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/grey"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"></View>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_height="70dp"
            android:layout_width="70dp"
            android:layout_gravity="center"
            android:id="@+id/image_dialog_icon"
            android:src="@drawable/placeholder_user"/>

        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:id="@+id/text_dialog_name"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:padding="2dp"
            android:textSize="@dimen/sp14"
            jp:fontName="@string/raleway_light"
            android:text="Name" />

        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:id="@+id/text_dialog_message"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:padding="2dp"
            android:text="Message"
            android:textSize="@dimen/sp14"
            android:textColor="@color/black"
            android:textStyle="bold"
            />




    </LinearLayout>





    <RelativeLayout

        android:layout_gravity="center"
        android:id="@+id/save_rlay"
        android:layout_width="match_parent"
        android:layout_marginTop="2dp"
        android:padding="3dp"
        android:layout_height="wrap_content"
        >

        <com.pacifyrapp.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Call"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:id="@+id/save_ctxv"
            android:textSize="@dimen/sp15"
            android:textColor="@color/colorPrimary" />

    </RelativeLayout>


</LinearLayout>

</RelativeLayout>


