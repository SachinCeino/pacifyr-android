<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/top_llay"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="1dp"
            android:gravity="center">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:id="@+id/user_cimv"
                android:src="@drawable/placeholder_user"/>


        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:orientation="vertical">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blue_text_dark"
                android:id="@+id/name_user_ctxv"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:id="@+id/calltype_imv"
                    android:src="@drawable/ic_videocam"/>


                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginLeft="7dp"
                    android:textColor="@color/black"
                    android:id="@+id/call_time_ctxv"/>

            </LinearLayout>
            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:text=""
                android:textColor="@color/grey_hex_7c"
                android:id="@+id/date_ctxv"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/colorPrimary"
                android:id="@+id/price_ctxv"/>



        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="left"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How you felt"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/grey_dark"
                android:id="@+id/felt_ctxv"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="Before call"
                android:textColor="@color/grey_dark"
                android:id="@+id/before_call_ctxv"/>

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:tint="@color/color_primary"
                android:layout_marginLeft="7dp"
                android:id="@+id/before_emotion_img"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text=""
                android:textColor="@color/colorPrimary"
                android:id="@+id/before_feel_ctxv"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="left"
            android:layout_marginLeft="3dp"
            android:orientation="vertical">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/grey_dark"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:text="After call"
                android:textColor="@color/grey_dark"
                android:id="@+id/after_call_ctxv"/>

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:tint="@color/colorPrimary"
                android:layout_marginLeft="7dp"
                android:id="@+id/after_emotion_img"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text=""
                android:textColor="@color/colorPrimary"
                android:id="@+id/after_feel_ctxv"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#cac8cd"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/top_llay"
        android:layout_alignParentBottom="true"
        android:background="#cac8cd"/>


</RelativeLayout>