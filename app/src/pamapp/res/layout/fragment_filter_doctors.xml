<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:rsb="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/tools"
    android:clickable="true"
    android:background="#F5F5F5"
    android:orientation="vertical"
    app:ignore="NamespaceTypo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/LinearLayout_Submit">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/root"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ffffff"
                android:orientation="vertical"
                android:padding="15dp">


                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort by"
                    android:textColor="@color/blue_fb"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select one"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:id="@+id/ETV_showSpecialities"
                    android:background="@drawable/black_border_white_back_search"
                    android:layout_marginBottom="15dp"
                    android:drawableEnd="@drawable/svg_down_arrow"
                    android:drawableRight="@drawable/svg_down_arrow" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/grey_dark"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">

                </View>

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold"
                    android:textColor="@color/blue_fb" />

                <com.pacifyr.client.views.PamEditTextMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Current Location"
                    android:padding="8dp"
                    android:background="@drawable/black_border_white_back"
                    android:layout_marginBottom="15dp" />

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold"
                    android:textColor="@color/blue_fb" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                        android:id="@+id/distanceSeekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        app:min_value="0"
                        app:max_value="100"
                        rsb:bar_color="#3F51B5"
                        rsb:bar_highlight_color="#3F51B5"
                        rsb:right_thumb_color="#2196F3"
                        rsb:right_thumb_color_pressed="#2196F3"
                        rsb:left_thumb_color_pressed="#2196F3"
                        rsb:left_thumb_color="#2196F3"
                        app:data_type="_integer" />

                    <TextView
                        android:layout_below="@+id/distanceSeekBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:padding="5dp"
                        android:id="@+id/textView_distance_min" />

                    <TextView
                        android:layout_below="@+id/distanceSeekBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:padding="5dp"
                        android:id="@+id/textView_distance_max" />
                </RelativeLayout>

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Office visit free range"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/blue_fb" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                        android:id="@+id/freerangeSeekbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        app:min_value="0"
                        app:max_value="100"
                        rsb:bar_color="#3F51B5"
                        rsb:bar_highlight_color="#3F51B5"
                        rsb:right_thumb_color="#2196F3"
                        rsb:right_thumb_color_pressed="#2196F3"
                        rsb:left_thumb_color_pressed="#2196F3"
                        rsb:left_thumb_color="#2196F3"
                        app:data_type="_integer" />


                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true"
                        android:padding="5dp"
                        android:layout_below="@+id/freerangeSeekbar"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/textView_fee_min" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentEnd="true"
                        android:padding="5dp"
                        android:layout_below="@+id/freerangeSeekbar"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/textView_fee_max" />
                </RelativeLayout>

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/blue_fb"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold" />
                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select one"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:id="@+id/txtv_gender"
                    android:background="@drawable/black_border_white_back_search"
                    android:layout_marginBottom="15dp"
                    android:drawableEnd="@drawable/svg_down_arrow"
                    android:drawableRight="@drawable/svg_down_arrow" />

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service"
                    android:textColor="@color/blue_fb"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select one"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:id="@+id/txtv_gender"
                    android:background="@drawable/black_border_white_back_search"
                    android:layout_marginBottom="15dp"
                    android:drawableEnd="@drawable/svg_down_arrow"
                    android:drawableRight="@drawable/svg_down_arrow" />

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I need it to:"
                    android:textColor="@color/blue_fb"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/ctxtv_acctet_walking"
                        android:layout_width="wrap_content"
                        android:layout_below="@+id/year_edt"
                        android:layout_marginTop="5dp"
                        android:textSize="@dimen/sp10"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content" />

                    <com.pacifyr.client.views.PamTextViewBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accept walk-ins"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/grey_dark"
                        android:textSize="@dimen/text_view_find_care_sub"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/ctxtv_openNow"
                        android:layout_width="wrap_content"
                        android:layout_below="@+id/year_edt"
                        android:layout_marginTop="5dp"
                        android:textSize="@dimen/sp10"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content" />

                    <com.pacifyr.client.views.PamTextViewBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Be open now"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/grey_dark"
                        android:textSize="@dimen/text_view_find_care_sub"
                        android:textStyle="bold" />

                </LinearLayout>


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LinearLayout_Submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="15dp"
        android:background="@drawable/blue_border_lightblue"
        android:gravity="center"
        android:orientation="vertical">

        <com.pacifyr.client.views.PamTextViewBold
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="apply"
            android:textColor="@color/white"
            android:textSize="@dimen/text_view_find_care_main"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>