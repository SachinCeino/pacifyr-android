<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/include"
        layout="@layout/actionbar_grey"
        android:layout_width="match_parent"
        android:layout_height="50dp"></include>
    <RelativeLayout
        android:layout_below="@+id/include"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#ffffff"
                android:id="@+id/root"
                android:padding="15dp">

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_view_find_care_main"
                    android:layout_marginBottom="15dp"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:lineSpacingExtra="10sp"
                    android:text="@string/where_are_you" />

                <com.pacifyr.client.views.PamEditTextMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/current_location"
                    android:id="@+id/etv_CurrentLocation"
                    android:padding="8dp"
                    android:background="@drawable/black_border_white_back"
                    android:layout_marginBottom="15dp" />

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_view_find_care_main"
                    android:layout_marginBottom="15dp"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:lineSpacingExtra="10sp"
                    android:text="@string/find_a_doctor" />

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="type"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold"
                    android:textColor="@color/blue_fb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/relative"
                    android:orientation="vertical">

                    <RadioGroup

                        android:id="@+id/segmentedgroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:orientation="horizontal"
                        android:layout_margin="5dp"

                        >

                        <RadioButton

                            android:id="@+id/rb1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/segment_background_radiobutton_empty_right_button"
                            android:button="@null"
                            android:gravity="center"
                            android:padding="5dp"
                            android:text="@string/primary_cares"
                            android:textColor="@color/colorPrimary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rb3"
                            android:layout_width="match_parent"
                            android:padding="5dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/segment_background_radiobutton_empty_left_button"
                            android:button="@null"
                            android:gravity="center"
                            android:text="Other"
                            android:textColor="@color/colorPrimary"
                            android:textStyle="bold"
                            android:textSize="19sp" />

                    </RadioGroup>

                </LinearLayout>

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Speciality"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:id="@+id/ETV_showSpecialities"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/black_border_white_back_search"
                    android:layout_marginBottom="15dp"
                    android:drawableEnd="@drawable/svg_down_arrow"
                    android:drawableRight="@drawable/svg_down_arrow" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:id="@+id/specialitiesLayout"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/black_border_white_back"
                    android:layout_marginBottom="15dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/specialitiesRCV"
                        android:scrollbars="vertical"
                        android:nestedScrollingEnabled="true"
                        android:scrollbarStyle="insideOverlay"
                        android:scrollbarSize="2dp"></androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/primaryLayout"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <com.pacifyr.client.views.PamTextViewBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facility"
                        android:textSize="@dimen/text_view_find_care_sub"
                        android:textStyle="bold"
                        android:textColor="@color/blue_fb" />

                    <com.pacifyr.client.views.PamEditTextMedium
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="eg.valley clinic"
                        android:padding="12dp"
                        android:focusedByDefault="false"
                        android:background="@drawable/black_border_white_back"
                        android:layout_marginBottom="15dp" />

                    <com.pacifyr.client.views.PamTextViewBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facility Type"
                        android:textSize="@dimen/text_view_find_care_sub"
                        android:textStyle="bold"
                        android:textColor="@color/blue_fb" />

                    <com.pacifyr.client.views.PamTextViewMedium
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Not available now"
                        android:gravity="center_vertical"
                        android:background="@drawable/black_border_white_back_search"
                        android:layout_marginBottom="15dp"
                        android:padding="8dp"
                        android:drawableEnd="@drawable/svg_down_arrow"
                        android:drawableRight="@drawable/svg_down_arrow" />
                </LinearLayout>

                <com.pacifyr.client.views.PamTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="name"
                    android:textSize="@dimen/text_view_find_care_sub"
                    android:textStyle="bold"
                    android:textColor="@color/blue_fb" />

                <com.pacifyr.client.views.PamEditTextMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="eg.Smith"
                    android:padding="8dp"
                    android:background="@drawable/black_border_white_back"
                    android:layout_marginBottom="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/submit"
                    android:orientation="vertical"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/blue_border_lightblue">

                    <com.pacifyr.client.views.PamTextViewMedium
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="search"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_view_find_care_main"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/footer"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/grey_dark"
            android:weightSum="5">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/grey_dark"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/svg_footer_find_care" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/footer_text_size"
                    android:text="Find Care"
                    android:textColor="@color/white"
                    android:padding="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/grey_dark"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/svg_footer_my_doctors" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/footer_text_size"
                    android:text="My Doctors"
                    android:textColor="@color/white"
                    android:padding="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center"></LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/grey_dark"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/svg_footer_spending" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/footer_text_size"
                    android:text="Spending"
                    android:textColor="@color/white"
                    android:padding="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/grey_dark"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="5dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/svg_footer_appts" />

                <com.pacifyr.client.views.PamTextViewMedium
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/footer_text_size"
                    android:text="Appts"
                    android:textColor="@color/white"
                    android:padding="5dp" />

            </LinearLayout>


        </LinearLayout>


    </RelativeLayout>
</RelativeLayout>
