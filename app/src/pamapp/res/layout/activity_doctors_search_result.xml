<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/grey_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/include"
        layout="@layout/actionbar_grey"
        android:layout_width="match_parent"
        android:layout_height="50dp"></include>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/include"
        android:id="@+id/filter_fragment_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:id="@+id/topLayout"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/relative"
                android:orientation="vertical">

                <RadioGroup

                    android:id="@+id/segmentedgroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:orientation="horizontal"
                    android:layout_margin="5dp"

                    >

                    <RadioButton

                        android:id="@+id/rblistView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background_radiobutton_empty_right_button"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingBottom="5dp"
                        android:paddingRight="10dp"
                        android:text="list view"
                        android:textColor="@color/colorPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbMapView"
                        android:layout_width="match_parent"
                        android:paddingLeft="10dp"
                        android:paddingBottom="5dp"
                        android:paddingRight="10dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/segment_background_radiobutton_empty_left_button"
                        android:button="@null"
                        android:gravity="center"
                        android:text="map view"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="19sp" />

                </RadioGroup>

            </LinearLayout>

            <com.pacifyr.client.views.PamTextViewBold
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="filter"
                android:id="@+id/txtv_filter"
                android:padding="5dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/primary_filter_round_background" />

        </LinearLayout>

        <RelativeLayout
            android:layout_below="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:id="@+id/mapViewTypeLayout">

                        <include
                            android:id="@+id/mapView"
                            layout="@layout/activity_maps"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                        </include>
                    </LinearLayout>


                    <com.pacifyr.client.views.PamTextViewMedium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:layout_marginLeft="10dp"
                        android:id="@+id/total_results"
                        android:textSize="16sp"
                        android:layout_below="@+id/mapViewTypeLayout"
                        android:textColor="@color/grey_dark" />

                    <LinearLayout
                        android:layout_below="@+id/total_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/listViewTypeLayout">

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="true"
                            android:id="@+id/rcv_SearchResult">
                        </androidx.recyclerview.widget.RecyclerView>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/viewLayout"
                            android:visibility="gone"
                            android:padding="5dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/desclaimertextView"
                                android:padding="3dp"
                                android:maxLines="3"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:text="@string/disclaimer_for_patient_scores">
                            </TextView>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="View more"
                                android:id="@+id/viewMore"
                                android:layout_below="@+id/desclaimertextView"
                                android:gravity="end"
                                android:layout_marginTop="5dp"
                                android:textColor="@color/black"
                                android:textStyle="bold">
                            </TextView>
                        </RelativeLayout>

                    </LinearLayout>

                </RelativeLayout>

            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>
