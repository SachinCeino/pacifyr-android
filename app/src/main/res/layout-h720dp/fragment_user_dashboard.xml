<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.pacifyr.client.fragment.UserDashboardFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/user_swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:id="@+id/LinearLayout_Active_Session"
                android:background="@color/white">
                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/active_session"
                    android:textSize="19sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    >

                </com.pacifyr.client.customview.MainTextView>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Join"
                    android:textSize="19sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:id="@+id/JoinCall"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="20dp"
                    android:background="@drawable/blue_border_blue_solid_rectangle_sharp"
                    >

                </com.pacifyr.client.customview.MainTextView>
                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Chat"
                    android:textSize="19sp"
                    android:padding="5dp"
                    android:id="@+id/JoinChat"
                    android:textColor="@color/white"
                    android:layout_marginLeft="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/blue_border_blue_solid_rectangle_sharp"
                    >

                </com.pacifyr.client.customview.MainTextView>
            </LinearLayout>

            <androidx.percentlayout.widget.PercentRelativeLayout
                android:id="@+id/percent_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:layout_below="@+id/LinearLayout_Active_Session"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/missed_chat_rlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="10dp"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/image_logo"
                        android:layout_width="@dimen/company_logo_w"
                        android:layout_height="@dimen/company_logo_h"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="5dp"
                        android:scaleType="centerInside" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_below="@+id/image_logo"
                        android:id="@+id/bannerLayout"
                        android:visibility="gone"

                        >
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            app:cardUseCompatPadding="true"
                            app:cardCornerRadius="3dp"
                            android:layout_marginLeft="15dp"
                            android:layout_marginRight="15dp"
                            android:id="@+id/bannerCard"

                            >
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                >
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/bannerLogoll"
                                    android:visibility="gone"
                                    >
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:cardCornerRadius="3dp"
                                        app:cardUseCompatPadding="true">
                                        <ImageView
                                            android:layout_width="66dp"
                                            android:layout_height="66dp"
                                            android:id="@+id/bannerLogo"
                                            android:scaleType="centerCrop"
                                            android:adjustViewBounds="true"></ImageView>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/bannerTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_toRightOf="@+id/bannerLogoll"
                                    android:text=""
                                    android:visibility="gone"
                                    android:textColor="@color/black"
                                    android:layout_margin="10dp"
                                    android:textSize="12sp" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_alignParentBottom="true"
                                    android:layout_alignParentRight="true"
                                    android:layout_margin="10dp"
                                    android:visibility="gone"
                                    android:id="@+id/ActionButtonJoin"
                                    android:padding="5dp"
                                    android:background="@drawable/blue_background_curve">
                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Join webinar"
                                        android:id="@+id/TextView_buttonText"
                                        android:textColor="@color/white"
                                        android:textSize="12sp" />
                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_alignParentRight="true"
                                        android:layout_alignParentBottom="true"
                                        android:src="@drawable/white_right_arrow"
                                        android:background="@android:color/transparent"
                                        >

                                    </ImageView>
                                </LinearLayout>
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                    </RelativeLayout>
                    <com.pacifyr.client.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/TextViewHideBanner"
                        android:text="Hide"
                        android:layout_below="@+id/bannerLayout"
                        android:textSize="12sp"
                        android:visibility="invisible"
                        android:layout_marginTop="10dp"
                        android:layout_centerInParent="true"
                        android:textColor="@color/grey_dark_text">

                    </com.pacifyr.client.customview.MainTextView>

                    <com.pacifyr.client.customview.MainTextView
                        android:id="@+id/unread_chat_ctxv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/TextViewHideBanner"
                        android:layout_alignParentStart="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="30dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <com.pacifyr.client.customview.MainTextView
                        android:id="@+id/missed_call_ctxv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/image_logo"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="40dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </RelativeLayout>


                <GridLayout
                    android:id="@+id/grid_balls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:columnCount="2"
                    android:foregroundGravity="center"
                    android:horizontalSpacing="5dp"
                    android:orientation="vertical"
                    android:rowCount="2"
                    android:layout_below="@+id/missed_chat_rlay"
                    android:layout_marginTop="25dp"
                    android:verticalSpacing="5dp">

                    <LinearLayout
                        android:layout_marginBottom="15dp"
                        android:layout_width="match_parent"
                        android:layout_rowWeight="1"
                        android:layout_columnSpan="2"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_gravity="center"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:background="@drawable/solid_circle"
                                android:elevation="6dp"
                                android:layout_width="@dimen/dash_circle_wh"
                                android:layout_height="@dimen/dash_circle_wh"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center">
                                <RelativeLayout
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:id="@+id/feel_rlay"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_horizontal"
                                    android:gravity="center">

                                    <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                                        android:layout_width="@dimen/dash_circle_wh"
                                        android:layout_height="@dimen/dash_circle_wh"
                                        android:elevation="7dp"
                                        android:id="@+id/feel_image_dimv"

                                        android:layout_centerHorizontal="true"
                                        android:layout_centerVertical="true"
                                        android:foregroundGravity="center"
                                        android:tint="@color/white"
                                        app:parameter="aspect_width"
                                        app:width_percentage="15" />

                                    <com.pacifyr.client.customview.MainTextView
                                        android:elevation="7dp"
                                        android:id="@+id/feel_title_ctxv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/feel_image_dimv"
                                        android:layout_centerHorizontal="true"
                                        android:textColor="@color/white"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <com.pacifyr.client.customview.MainTextView
                                        android:elevation="7dp"
                                        android:id="@+id/text_feel_error"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/feel_image_dimv"
                                        android:layout_centerHorizontal="true"
                                        android:layout_centerVertical="true"
                                        android:gravity="center"
                                        android:text="@string/please_select_an_emotion"
                                        android:textColor="@color/white"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />

                                </RelativeLayout>
                            </RelativeLayout>

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:padding="5dp"
                                android:text="@string/my_last_emotion"
                                android:textAllCaps="true"
                                android:textColor="@color/text_dashboard"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:background="@drawable/solid_circle"
                                android:elevation="6dp"
                                android:id="@+id/cir_pref_pacifyr"
                                android:layout_width="@dimen/dash_circle_wh"
                                android:layout_height="@dimen/dash_circle_wh"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center">

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/no_pacifyr_ctxv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:gravity="center"
                                    android:padding="10dp"
                                    android:text="@string/___"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true">
                                    <LinearLayout
                                        android:id="@+id/llay_top"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:visibility="visible">

                                        <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                                             android:layout_width="wrap_content"
                                             android:layout_height="wrap_content"
                                             app:parameter="aspect_width"
                                             app:width_percentage="11"
                                             android:src="@drawable/placeholder_user"
                                             android:id="@+id/pacifyr1_dimv"/>-->

                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/pacifyr1_dimv"
                                            android:layout_width="40dp"
                                            android:background="?android:attr/selectableItemBackgroundBorderless"
                                            android:clickable="true"
                                            android:layout_height="40dp" />


                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/pacifyr2_dimv"
                                            android:layout_width="40dp"
                                            android:background="?android:attr/selectableItemBackgroundBorderless"
                                            android:clickable="true"
                                            android:layout_height="40dp"
                                            android:layout_marginStart="15dp" />


                                        <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                                             android:layout_width="wrap_content"
                                             android:layout_height="wrap_content"
                                             app:parameter="aspect_width"
                                             android:layout_marginStart="15dp"
                                             app:width_percentage="11"
                                             android:src="@drawable/placeholder_user"
                                             android:id="@+id/pacifyr2_dimv"/>-->


                                    </LinearLayout>

                                    <LinearLayout

                                        android:id="@+id/llay_bottom"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/llay_top"
                                        android:layout_marginTop="5dp"
                                        android:gravity="center"
                                        android:orientation="horizontal"
                                        android:visibility="gone">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/pacifyr3_dimv"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            android:background="?android:attr/selectableItemBackgroundBorderless"
                                            android:clickable="true" />

                                        <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                                             android:layout_width="wrap_content"
                                             android:layout_height="wrap_content"
                                             app:parameter="aspect_width"
                                             app:width_percentage="11"
                                             android:src="@drawable/placeholder_user"
                                             android:id="@+id/pacifyr3_dimv"/>-->


                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/pacifyr4_dimv"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            android:background="?android:attr/selectableItemBackgroundBorderless"
                                            android:clickable="true"
                                            android:layout_marginStart="15dp" />


                                    </LinearLayout>
                                </RelativeLayout>

                            </RelativeLayout>

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="5dp"
                                android:textAllCaps="true"
                                android:text="@string/pref_wellness_experts"
                                android:textColor="@color/text_dashboard"
                                android:textSize="13sp"
                                android:textStyle="bold" />


                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_rowWeight="1"
                        android:layout_columnSpan="2"
                        android:layout_marginTop="30dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_gravity="center"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:background="@drawable/solid_circle"
                                android:elevation="6dp"
                                android:layout_width="@dimen/dash_circle_wh"
                                android:layout_height="@dimen/dash_circle_wh"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center">
                                <RelativeLayout
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:id="@+id/last_session_rlay"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_horizontal"
                                    android:gravity="center">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:id="@+id/no_lastsession_ctxv"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:layout_centerHorizontal="true"
                                        android:layout_centerVertical="true"
                                        android:gravity="center"
                                        android:padding="10dp"
                                        android:text="@string/___"

                                        android:textColor="@color/white"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />

                                    <LinearLayout
                                        android:layout_centerInParent="true"
                                        android:id="@+id/last_session_top_llay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:visibility="visible">

                                        <de.hdodenhof.circleimageview.CircleImageView
                                            android:id="@+id/last_session_dimv"
                                            android:layout_width="50dp"
                                            android:layout_height="50dp"
                                            android:layout_centerHorizontal="true"
                                            android:background="@drawable/user"
                                            android:visibility="visible" />


                                        <com.pacifyr.client.customview.MainTextView
                                            android:id="@+id/lastSsn_pacfyr_ctxv"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@+id/last_session_dimv"
                                            android:layout_centerHorizontal="true"
                                            android:ellipsize="end"
                                            android:gravity="center"
                                            android:maxLines="2"
                                            android:padding="1dp"
                                            android:text=""
                                            android:textColor="@color/white"
                                            android:textSize="15sp"
                                            android:textStyle="bold" />

                                        <LinearLayout
                                            android:id="@+id/session_llay"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/lastSsn_pacfyr_ctxv"
                                            android:gravity="center"
                                            android:orientation="horizontal"
                                            android:visibility="visible">

                                            <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                                                android:id="@+id/video_cam_img"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@drawable/ic_video_cam_blue"
                                                app:parameter="aspect_width"
                                                app:width_percentage="4" />

                                            <com.pacifyr.client.customview.MainTextView
                                                android:id="@+id/last_session_minute_txv"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_centerHorizontal="true"
                                                android:layout_marginStart="10dp"
                                                android:text="@string/_00"
                                                android:textColor="@color/white"
                                                android:textSize="13sp"
                                                android:textStyle="bold" />

                                        </LinearLayout>

                                        <com.pacifyr.client.customview.MainTextView
                                            android:id="@+id/days_txv"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/session_llay"
                                            android:layout_centerHorizontal="true"
                                            android:padding="5dp"
                                            android:text="@string/_0_days_ago"
                                            android:textColor="#ffffff"
                                            android:textSize="11sp"
                                            android:visibility="visible" />
                                        <com.pacifyr.client.customview.MainTextView
                                            android:id="@+id/Text_appointmentTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/session_llay"
                                            android:layout_centerHorizontal="true"
                                            android:padding="5dp"
                                            android:text="@string/_0_days_ago"
                                            android:textColor="#ffffff"
                                            android:textSize="11sp"
                                            android:visibility="gone" />

                                    </LinearLayout>


                                </RelativeLayout>
                            </RelativeLayout>

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:padding="5dp"
                                android:text="@string/my_last_session"
                                android:textColor="@color/text_dashboard"
                                android:textSize="13sp"
                                android:id="@+id/MyLastSessionTitle"
                                android:textAllCaps="true"
                                android:textStyle="bold" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:background="@drawable/solid_circle"
                                android:elevation="6dp"
                                android:layout_width="@dimen/dash_circle_wh"
                                android:layout_height="@dimen/dash_circle_wh"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center">
                                <RelativeLayout
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:id="@+id/this_week_rlay"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_horizontal"
                                    android:gravity="center">


                                    <LinearLayout
                                        android:layout_centerInParent="true"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <LinearLayout
                                            android:id="@+id/week1_llay"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal">

                                            <com.pacifyr.client.customview.MainTextView
                                                android:id="@+id/sessions_txv"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="@string/_00"
                                                android:textColor="@color/white"
                                                android:textSize="20sp" />

                                            <com.pacifyr.client.customview.MainTextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="7dp"
                                                android:text="@string/sessionS"
                                                android:textColor="@color/text_inside_circle_light"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />

                                        </LinearLayout>

                                        <LinearLayout
                                            android:id="@+id/week2_llay"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_below="@id/week1_llay"
                                            android:orientation="horizontal">

                                            <com.pacifyr.client.customview.MainTextView
                                                android:id="@+id/hours_txv"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="10dp"
                                                android:text="@string/_00"
                                                android:textColor="@color/white"
                                                android:textSize="20sp" />


                                            <com.pacifyr.client.customview.MainTextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="7dp"
                                                android:layout_marginTop="10dp"
                                                android:text="@string/hrs"
                                                android:textColor="@color/text_inside_circle_light"
                                                android:textSize="10sp"
                                                android:textStyle="bold" />


                                            <com.pacifyr.client.customview.MainTextView
                                                android:id="@+id/min_ctxv"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
