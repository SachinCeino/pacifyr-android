<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.pacifyr.omhealthcare.fragment.UserDashboardFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/pacifyr_swipe_layout">

        <ScrollView
            android:fillViewport="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.percentlayout.widget.PercentRelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_below="@+id/include"
            android:id="@+id/online_switch_llay">

          <!--  <Switch
                android:id="@+id/online_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                app:layout_heightPercent="5%"
                android:padding="10dp"
                android:shadowColor="@color/red"
                android:text="" />-->

            <com.ceino.utilitylibrary.DeviceFitImageView
                android:id="@+id/online_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:src="@drawable/online_offline_selector"
                app:width_percentage="20"
                app:parameter="aspect_width"
                android:padding="1dp"
                android:text="" />


            <com.ceino.utilitylibrary.DeviceFitImageView
                android:id="@+id/chat_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="70dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/chat_selector"
                app:width_percentage="20"
                app:parameter="aspect_width"
                android:padding="1dp"
                android:text="" />

        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_below="@+id/online_switch_llay"
            android:id="@+id/missed_chat_rlay">

            <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginLeft="30dp"
                    android:layout_alignParentLeft="true"
                    android:id="@+id/unread_chat_ctxv"
                    android:text=""/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:visibility="gone"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginRight="40dp"
                    android:id="@+id/missed_call_ctxv"
                    android:text=""/>

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginRight="10dp"
            app:layout_heightPercent="30%"
            app:layout_widthPercent="50%"
            android:padding="20dp"
            app:layout_marginTopPercent="2%"
            android:layout_below="@id/missed_chat_rlay"
            android:id="@+id/current_rating_rlay"
            android:background="@drawable/solid_circle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:id="@+id/rating_inner_llay"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="3dp"
                    android:id="@+id/this_week_rating_llay"
                    android:orientation="horizontal">

                    <com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:parameter="aspect_width"
                        app:width_percentage="10"
                        android:src="@drawable/star3x"
                        android:id="@+id/star_dimv"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:textColor="#ffffff"
                        android:text="0.0"
                        android:layout_marginLeft="5dp"
                        android:id="@+id/rating_ctxv"/>

                </LinearLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:id="@+id/zero_review_ctxv"
                    android:visibility="visible"
                    android:textSize="@dimen/sp12"
                    android:padding="5dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_inside_circle_light"
                    android:text="0 reviews"/>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:id="@+id/rating_session_llay"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#ffffff"
                            android:text="00"
                            android:id="@+id/rating_session_ctxv"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="@color/text_inside_circle_light"
                            android:text="@string/sessions"/>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:layout_marginLeft="60dp"
                        android:id="@+id/stars5_llay"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#ffffff"
                            android:text="$ 00"
                            android:id="@+id/rating_stars_ctxv"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="@color/text_inside_circle_light"
                            android:text="@string/starts"/>
                    </LinearLayout>

                </RelativeLayout>



            </LinearLayout>


        </RelativeLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="5dp"
            android:layout_marginLeft="25dp"
            android:layout_below="@id/current_rating_rlay"
            android:textColor="@color/text_dashboard"
            android:text="@string/current_rating"/>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_marginTopPercent="2%"
            app:layout_heightPercent="30%"
            app:layout_widthPercent="50%"
            android:layout_below="@id/missed_chat_rlay"
            android:layout_toRightOf="@id/current_rating_rlay"
            android:id="@+id/last_session_rlay"
            android:background="@drawable/solid_circle">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:id="@+id/no_lastsession_ctxv"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:text="No sessions yet"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="visible"
                android:id="@+id/last_session_top_llay"
                android:orientation="vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/last_session_dimv"
                    android:src="@drawable/placeholder_user"/>

                <!--<com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:parameter="aspect_width"
                    app:width_percentage="10"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/placeholder_user"
                    android:id="@+id/last_session_dimv"/>-->

                <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:id="@+id/lastSsn_pacfyr_ctxv"
                    android:text=""
                    android:layout_below="@+id/last_session_dimv"
                    android:layout_centerHorizontal="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/session_llay"
                    android:gravity="center"
                    android:layout_below="@id/lastSsn_pacfyr_ctxv"
                    android:orientation="horizontal">

                    <com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:parameter="aspect_width"
                        app:width_percentage="5"
                        android:tint="@color/video_cam_color"
                        android:src="@drawable/ic_video_cam_blue"
                        android:id="@+id/video_cam_img"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginLeft="5dp"
                        android:id="@+id/last_session_minute_txv"
                        android:textColor="@color/white"
                        android:text=""
                        android:layout_centerHorizontal="true" />


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginLeft="5dp"
                        android:id="@+id/last_session_cost_txv"
                        android:textColor="@color/white"
                        android:text=""
                        android:layout_centerHorizontal="true" />



                </LinearLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:padding="5dp"
                    android:id="@+id/days_txv"
                    android:layout_below="@id/session_llay"
                    android:textColor="@color/text_inside_circle_light"
                    android:text=""
                    android:layout_centerHorizontal="true" />

            </LinearLayout>


        </RelativeLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="5dp"
            android:layout_marginLeft="20sp"
            android:layout_toRightOf="@id/current_rating_rlay"
            android:layout_below="@id/last_session_rlay"
            android:textColor="@color/text_dashboard"
            android:text="@string/last_session"/>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_marginTopPercent="13%"
            app:layout_heightPercent="30%"
            app:layout_widthPercent="50%"
            android:gravity="center"
            android:layout_marginRight="10dp"
            android:layout_below="@id/current_rating_rlay"
            android:id="@+id/cir_pref_pacifyr"
            android:background="@drawable/solid_circle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:padding="5dp"
                    android:textColor="@color/text_inside_circle_light"
                    android:text=""
                    android:id="@+id/date_ctxv"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:id="@+id/week1_llay"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:text="00"
                        android:id="@+id/earning_hours_ctxv"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:textColor="@color/text_inside_circle_light"
                        android:text="@string/hours"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginLeft="15dp"
                    android:foregroundGravity="center"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:text="55"
                        android:id="@+id/earning_minutes_ctxv"/>


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:textColor="@color/text_inside_circle_light"
                        android:text="@string/minutes"/>
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5sp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center" android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:text="33"
                            android:id="@+id/sessions_ctxv"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="@color/text_inside_circle_light"
                            android:text="@string/sessions"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginLeft="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/white"
                            android:text="33"
                            android:id="@+id/earned_ctxv"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:textColor="@color/text_inside_circle_light"
                            android:text="@string/earned"/>
<!-- android:text="@string/earned"-->
                    </LinearLayout>

                </LinearLayout>



            </LinearLayout>






        </RelativeLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="10dp"
            android:layout_marginLeft="35sp"
            android:textColor="@color/text_dashboard"
            android:text="@string/earnings"
            android:layout_below="@+id/cir_pref_pacifyr"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />



        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_marginTopPercent="13%"
            app:layout_heightPercent="30%"
            app:layout_widthPercent="50%"
            android:gravity="center"
            android:layout_below="@id/current_rating_rlay"
            android:layout_toRightOf="@id/cir_pref_pacifyr"
            android:layout_marginTop="50dp"
            android:id="@+id/customers_rlay"
            android:background="@drawable/solid_circle">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/llay_top"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- <com.ceino.utilitylibrary.DeviceFitImageView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     app:parameter="aspect_width"
                     app:width_percentage="11"
                     android:src="@drawable/placeholder_user"
                     android:id="@+id/pacifyr1_dimv"/>-->

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:layout_marginRight="15dp"
                    android:id="@+id/customer1_dimv"
                    android:src="@drawable/placeholder_user"/>


                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:id="@+id/customer2_dimv"
                    android:src="@drawable/placeholder_user"/>


                <!-- <com.ceino.utilitylibrary.DeviceFitImageView
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     app:parameter="aspect_width"
                     android:layout_marginLeft="15dp"
                     app:width_percentage="11"
                     android:src="@drawable/placeholder_user"
                     android:id="@+id/pacifyr2_dimv"/>-->


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/llay_bottom"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/llay_top"
                android:orientation="horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:layout_marginRight="15dp"
                    android:id="@+id/customer3_dimv"
                    android:src="@drawable/placeholder_user"/>


                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:parameter="aspect_width"
                    app:width_percentage="11"
                    android:padding="9dp"
                    android:background="@drawable/circle_line_border"
                    android:src="@drawable/ic_more_menu"
                    android:id="@+id/search_dimv"/>

                <!--       android:background="@drawable/circle_line_border"
                        android:src="@drawable/ic_more_menu"-->

            </LinearLayout>


        </RelativeLayout>

                <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="5dp"
            android:id="@+id/this_week_ctxv"
            android:layout_marginLeft="40dp"
            android:layout_toRightOf="@id/current_rating_rlay"
            android:layout_below="@id/customers_rlay"
            android:textColor="@color/text_dashboard"
            android:text="@string/customers"/>


            </androidx.percentlayout.widget.PercentRelativeLayout>


        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!--<android.support.design.widget.NavigationView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:menu="@menu/menu_navigation"
        android:layout_gravity="start">
    </android.support.design.widget.NavigationView>-->

</FrameLayout>
