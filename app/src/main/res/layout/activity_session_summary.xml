<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp"
        tools:ignore="MissingConstraints">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_gravity="center"
            android:background="?attr/colorPrimary"
            android:layout_alignParentTop="true"

            android:id="@+id/action_bar"
            android:orientation="horizontal"
            android:theme="@style/AppTheme.PopupOverlay">
            <include layout="@layout/actionbar_three_text_image"/>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_above="@+id/submit_ctxv"
            android:layout_below="@+id/action_bar"
            android:background="@color/white"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:tools="http://schemas.android.com/tools"
                    android:id="@+id/activity_last_session"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingLeft="20dp"
                    android:paddingTop="20dp"
                    android:paddingRight="20dp"
                    android:paddingBottom="50dp"
                    tools:context="com.pacifyr.client.home.LastSessionActivity">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_white"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/last_session_cimv"
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:src="@drawable/placeholder_user" />

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/callback_ctxv"
                                android:layout_width="80dp"
                                android:layout_height="30dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/button_border"
                                android:gravity="center"
                                android:text="Call Back"
                                android:textColor="@color/colorPrimary" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="left"
                                android:orientation="horizontal"
                                android:paddingLeft="10dp">

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/pacifyr_name_ctxv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:text=""
                                    android:textColor="@color/black"
                                    android:textSize="18sp" />

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/pacifyr_rate_ctxv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/pacifyr_name_ctxv"
                                    android:layout_alignParentLeft="true"
                                    android:text=""
                                    android:textColor="@color/md_grey_user"
                                    android:textSize="13sp" />

                                <ImageButton
                                    android:id="@+id/img_notes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_margin="5dp"
                                    android:background="@android:color/transparent"
                                    android:visibility="gone"
                                    app:srcCompat="@drawable/svg_add_note_primary" />

                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingLeft="10dp">

                                <com.pacifyr.client.customview.MainTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:text="CALL :"
                                    android:textColor="@color/grey_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/call_type_dimv"
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginLeft="5dp"
                                    android:src="@drawable/icon_audio" />

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/duration_ctxv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginLeft="5dp"
                                    android:text=" 00 : 00 : 00"
                                    android:textColor="@color/blue_text_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />


                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/customer_fees_llay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal"
                                android:paddingLeft="10dp"
                                android:visibility="gone">

                                <com.pacifyr.client.customview.MainTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:text="TOTAL :"
                                    android:textColor="@color/grey_hex_b3"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <com.pacifyr.client.customview.MainTextView
                                    android:id="@+id/session_cost_ctxv"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:text="  "
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/eye_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="5dp"
                                    android:src="@drawable/i_icon"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/pacifyr_earings_llay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical"
                                android:paddingLeft="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="0dp"
                                    android:orientation="horizontal">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text="Earnings :"
                                        android:textColor="@color/grey_dark"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <com.pacifyr.client.customview.MainTextView
                                        android:id="@+id/earingst_ctxv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:text="  "
                                        android:textColor="@color/blue_text_dark"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text="Company Fees :"
                                        android:textColor="@color/grey_dark"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <com.pacifyr.client.customview.MainTextView
                                        android:id="@+id/comapnyfees_ctxv"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:text="  "
                                        android:textColor="@color/blue_text_dark"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                        <!-- circleview:suffixValue="EUR"-->

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DFDFDF" />

                    <com.pacifyr.client.customview.MainTextView
                        android:id="@+id/mTextView_View_pres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/blue_border_white_background_round"
                        android:drawableLeft="@drawable/prescription"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/colorPrimary"
                        android:padding="10dp"
                        android:text="View Prescription"
                        android:textColor="@color/colorPrimary" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/how_eff_ctxv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="@string/your_call_effectiveness"
                            android:textColor="@color/md_grey_user"
                            android:textSize="14sp" />


                        <RelativeLayout
                            android:id="@+id/mmmmm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/how_eff_ctxv"
                            android:gravity="center"
                            android:orientation="horizontal">


                            <app.minimize.com.seek_bar_compat.SeekBarCompat
                                android:id="@+id/effective_seekbar"
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                app:progressBackgroundColor="#000"
                                app:progressColor="@color/colorPrimary"
                                app:thumbAlpha="1.0"
                                app:thumbColor="@color/grey_fit" />
                            <!--         android:maxHeight="300sp"-->

                            <com.eralp.circleprogressview.CircleProgressView
                                android:id="@+id/circle_progress_view"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_gravity="center"
                                android:layout_marginLeft="20dp"
                                android:layout_toRightOf="@+id/effective_seekbar"
                                app:cpv_background_circle_color="#5b253048"
                                app:cpv_background_circle_width="1dp"
                                app:cpv_circle_color="@color/colorPrimary"
                                app:cpv_circle_width="3dp"
                                app:cpv_text_color="@color/colorPrimary"
                                app:cpv_text_size="20"
                                app:cpv_text_suffix="%" />


                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rating_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/rating_ctxv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/how_you_rate"
                            android:textColor="@color/md_grey_user"
                            android:textSize="14sp" />
                        <!--               <RatingBar
                                android:id="@+id/rating_bar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:rating="2"
                                android:fitsSystemWindows="true"
                                android:numStars="5"
                                android:stepSize="1"
                                android:theme="@style/RatingBar"
                                android:gravity="left"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/rating_ctxv"
                                android:layout_marginLeft="10dp"
                                android:isIndicator="false"
                               />-->
                        <com.willy.ratingbar.ScaleRatingBar
                            android:id="@+id/rating_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/rating_ctxv"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            app:srb_clickable="true"
                            app:srb_numStars="5"
                            app:srb_starPadding="10dp"></com.willy.ratingbar.ScaleRatingBar>


                    </RelativeLayout>


                    <RelativeLayout
                        android:id="@+id/before_feel_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/before_feel_ctxv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/your_feeling_before_call"
                            android:textColor="@color/md_grey_user"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/frame_before_feel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/before_feel_ctxv"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="5dp">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/img_blue_bg"
                                android:layout_width="39dp"
                                android:layout_height="39dp"
                                android:layout_alignParentBottom="true"
                                android:layout_centerHorizontal="true"
                                android:layout_gravity="center_horizontal|center_vertical"
                                android:src="@color/colorPrimary"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/before_feel_dimv"
                                android:layout_width="40dp"
                                android:layout_height="40dp" />
                        </FrameLayout>

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/before_emotion_ctxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/frame_before_feel"
                            android:layout_marginLeft="16dp"
                            android:text="emotion"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp12" />

                    </RelativeLayout>

                    <!--<RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/after_feel_llay"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/after_feel_ctxv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:text="How were you feeling after the call ?"
                                android:textColor="@color/md_grey_user"
                                android:textSize="20sp" />

                            <ImageView
                                android:id="@+id/after_feel_dimv"
                                android:layout_width="40dp"
                                android:layout_marginTop="5dp"
                                android:layout_below="@+id/after_feel_ctxv"
                                android:layout_height="40dp"
                                android:layout_marginLeft="20dp" />

                        </RelativeLayout>-->

                    <RelativeLayout
                        android:id="@+id/after_feel_selection_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/after_feel_selection_ctxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/your_feeling_after_call"
                            android:textColor="@color/md_grey_user"
                            android:textSize="14sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/begning_rcv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/after_feel_selection_ctxv"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/experica_ctxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How was your audio or video call experience?"
                            android:textColor="@color/md_grey_user"
                            android:textSize="14sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/comments_rcv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/experica_ctxv"
                            android:layout_marginTop="5dp" />

                        <com.pacifyrapp.utilitylibrary.CustomEditText
                            android:id="@+id/comments_cedt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/comments_rcv"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@android:color/transparent"
                            android:hint="@string/comments"
                            android:inputType="textCapSentences|textMultiLine"
                            android:textColorHighlight="@color/text_Color_High_light"
                            android:textColorHint="@color/hint_dark"
                            android:textSize="@dimen/sp17" />

                    </RelativeLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>


        </RelativeLayout>

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="20dp"
            android:id="@+id/submit_ctxv"
            android:padding="10dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:background="@drawable/blue_border_lightblue"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Submit"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>