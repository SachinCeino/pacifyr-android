<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/gray_actionbar_background"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/action_bar_top_llay"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        >


        <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/bottom_panel"
            android:animateLayoutChanges="true"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/left_llay"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:paddingStart="10dp"
                android:layout_centerHorizontal="true"
                android:layout_height="wrap_content">
                <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/back_imv"
                    android:layout_height="wrap_content"
                    android:src="@drawable/backarrow"
                    app:width_percentage="8"
                    app:parameter="aspect_width"
                    android:padding="3dp"
                    android:tint="@color/_color_back_arrow_tint"
                    android:visibility="gone"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentStart="true" />

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/back_imv"
                    android:id="@+id/left_txv"
                    android:paddingStart="2dp"
                    android:textSize="@dimen/sp14"
                    android:visibility="gone"
                    android:text=""
                    android:layout_centerVertical="true"
                    android:textColor="@color/_color_action_bar_text_color"
                    />
            </LinearLayout>

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="25"
                android:ellipsize="end"
                android:layout_centerInParent="true"
                android:text=""
                android:padding="5dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/sp15"
                android:id="@+id/title_txv"
                android:textColor="@color/_color_action_bar_text_color"
                />
            <!--  app:font="@string/avenir_roman"-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/right_llay"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingEnd="5dp"
                android:layout_centerHorizontal="true"
                android:layout_height="wrap_content">

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_toLeftOf="@+id/right_imv"
                    android:id="@+id/right_txv"
                    android:paddingEnd="2dp"
                    android:textSize="@dimen/sp18"
                    android:text=""

                    android:textColor="@color/_color_action_bar_text_color"
                    android:layout_centerVertical="true"
                    />
                <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/right_imv"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:width_percentage="7"

                    android:layout_marginEnd="4dp"

                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"/>
                <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                     android:layout_width="wrap_content"
                     android:id="@+id/right2_dimv"
                     android:layout_height="wrap_content"
                     android:visibility="gone"
                     app:width_percentage="7"
                     android:src="@drawable/icon_preferences"
                     android:layout_marginEnd="5dp"

                     android:layout_centerVertical="true"
                     android:layout_centerHorizontal="true"
                     android:layout_alignParentEnd="true" />-->

            </LinearLayout>

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:id="@+id/connectProviderActioBar"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingEnd="5dp"
                android:text="Connect"
                android:visibility="gone"
                android:layout_marginRight="5dp"
                android:textStyle="bold"
                android:textColor="@color/blue_pacifyr"
                android:layout_centerHorizontal="true"
                android:layout_height="wrap_content">

            </com.pacifyr.client.customview.MainTextView>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
