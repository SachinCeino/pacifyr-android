<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:jp="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CustomNoActionBarTheme"
    android:layout_height="wrap_content"
    android:background="@drawable/white_round_square"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:padding="10dp"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="8dp"
                android:textColor="#000000"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:text="@string/add_education"
                android:textSize="15sp"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/close_dimv"
                android:scaleType="fitXY"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_clear_black_24dp"/>

        </RelativeLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical">

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/collage_edt"
                android:padding="10dp"
                android:inputType="textCapSentences|textMultiLine"
                android:textCursorDrawable="@color/grey_hex_4c"
                android:background="@null"
                android:hint="@string/prompt_collage"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_hex_6c"
                app:layout_constraintEnd_toEndOf="@+id/name_txv"/>


            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/location_edt"
                android:padding="10dp"
                android:textCursorDrawable="@color/grey_hex_4c"
                android:inputType="textCapWords"
                android:background="@null"
                android:hint="@string/location"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_hex_6c"
                app:layout_constraintEnd_toEndOf="@+id/name_txv"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp18"
                android:textColor="@color/black"
                android:id="@+id/from_ctxv"
                android:padding="10dp"
                android:text="@string/from"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_hex_6c"
                app:layout_constraintEnd_toEndOf="@+id/name_txv"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp18"
                android:textColor="@color/black"
                android:padding="10dp"
                android:id="@+id/to_ctxv"
                android:text="@string/to"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_hex_6c"
                app:layout_constraintEnd_toEndOf="@+id/name_txv"/>


        </LinearLayout>





        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/save_rlay"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:layout_height="wrap_content">

            <!--<TextView
                android:id="@+id/cancel_ctxv"
                android:layout_width="80dp"
                android:gravity="center"
                android:layout_height="30dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="24dp"
                android:text="Cancel"
                android:textColor="#3F51B5"
                android:textSize="@dimen/sp15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                jp:ignore="MissingConstraints" />-->


            <com.ceino.utilitylibrary.CustomFontTextView
                android:id="@+id/save_ctxv"
                android:layout_width="80dp"
                android:gravity="center"
                android:background="@drawable/blue_border_white_background_solid"
                android:layout_height="30dp"
                android:layout_marginBottom="14dp"
                android:layout_marginTop="24dp"
                android:text="Save"
                android:textColor="#3F51B5"
                android:textSize="@dimen/sp15" />

        </RelativeLayout>


    </LinearLayout>

</RelativeLayout>


