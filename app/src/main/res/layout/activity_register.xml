<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent">
    </include>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <android.support.percent.PercentRelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <RelativeLayout
            android:id="@+id/logo_rlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:layout_marginTopPercent="5%">

            <ImageView
                android:layout_width="150dp"
                android:src="@drawable/omhealth_icon_orange"
                android:layout_height="150dp"
                android:layout_centerHorizontal="true"
                android:id="@+id/logo_blue"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:id="@+id/profile_cimv"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/logo_blue"
                android:src="@drawable/ic_camera"/>


           <!-- <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_camera"
                android:id="@+id/user_img"
                android:layout_below="@+id/logo_blue"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true" />-->


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/hint_llay"
            android:layout_below="@+id/logo_rlay"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            app:layout_marginTopPercent="10%"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.ceino.utilitylibrary.CustomEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/name_edt"
                android:inputType="textCapSentences"
                android:textSize="@dimen/sp16"
                android:gravity="left"
                android:textColor="@color/medium_grey_pacifyr"
                android:hint="@string/prompt_name"/>

            <com.ceino.utilitylibrary.CustomEditText
                android:id="@+id/email_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:gravity="left"
                android:layout_below="@+id/name_edt"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/sp16"
                android:hint="@string/prompt_email"
                android:textColor="@color/medium_grey_pacifyr"
                android:layout_height="wrap_content" />


            <com.ceino.utilitylibrary.CustomEditText
                android:id="@+id/phone_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:gravity="left"
                android:visibility="visible"
                android:inputType="phone"
                android:layout_below="@+id/email_edt"
                android:clickable="false"
                android:textColor="@color/blue_fb"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:id="@+id/phone_llay"
                android:visibility="gone"
                android:layout_below="@+id/phone_edt"
                android:layout_height="wrap_content">

                <!--<com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView"
                    android:layout_alignLeft="@+id/textView"/>


                <com.ceino.utilitylibrary.CustomEditText
                    android:id="@+id/phone_cedit"
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:textSize="@dimen/sp17"
                    android:maxLength="10"
                    android:background="@null"
                    android:maxLines="1"
                    android:hint="@string/phone"
                    android:textColorHint="@color/phone_grey"
                    android:layout_height="40dp" />

            </LinearLayout>

            <com.aigestudio.wheelpicker.widgets.WheelYearPicker
                android:id="@+id/wheel_date_picker_year"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="10dp"
                app:wheel_visible_item_count="3"
                app:wheel_curved="true"
                android:visibility="gone"
                android:layout_below="@+id/phone_llay"/>

            <com.ceino.utilitylibrary.CustomEditText
                android:id="@+id/year_edt"
                android:layout_marginTop="20dp"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:gravity="left"
                android:hint="Year of birth"
                android:background="@null"
                android:layout_below="@+id/wheel_date_picker_year"
                android:textColor="@color/medium_grey_pacifyr"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/checkBox"
                android:layout_width="wrap_content"
                android:layout_below="@+id/year_edt"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/sp10"
                android:layout_height="wrap_content" />

          <!--  <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:id="@+id/read_ctxv"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/checkBox"
                android:layout_marginTop="10dp"
                android:textColor="@color/black"
                android:layout_below="@+id/year_edt"
                android:textSize="12dp"
                android:text="@string/read_understand"/>-->

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/checkBox"
                android:id="@+id/terms_of_use"
                android:layout_below="@+id/year_edt"
                android:textSize="10dp"
                android:layout_marginTop="20dp"
                android:text="@string/term_of_use"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </LinearLayout>



        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/hint_llay"
            android:id="@+id/next_llay"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:gravity="center_horizontal"
            app:layout_marginBottomPercent="5%"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/next_rlay"
                android:layout_width="match_parent"
                android:layout_marginTop="15dp"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_round_square"
                android:padding="10dp">

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/next_ctxv"
                    android:textSize="20sp"
                    android:textColor="@color/white" />


            </RelativeLayout>

        </LinearLayout>


    </android.support.percent.PercentRelativeLayout>
</ScrollView>

</LinearLayout>