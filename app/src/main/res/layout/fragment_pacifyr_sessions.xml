<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_hex_f8"
    tools:context="com.pacifyr.client.fragment.MySessionFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:id="@+id/tab_rlay"
            android:padding="1dp"
            android:layout_height="wrap_content"
            android:weightSum="3">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/blue_line_bottom"
                android:textSize="15sp"
                android:id="@+id/this_wk_ctxv"
                android:padding="10dp"
                android:textStyle="bold"
                android:textColor="@color/blue_pacifyr"
                android:text="Weekly"
                android:gravity="center"
                android:layout_gravity="left|center_vertical" />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Monthly"
                android:padding="10dp"
                android:textStyle="bold"
                android:id="@+id/this_mnt_ctxv"
                android:background="@color/grey_hex_f8"
                android:textColor="@color/grey_hex_c7"
                android:textSize="15sp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1" />

            <com.pacifyr.client.customview.MainTextView
                android:text="Yearly"
                android:layout_width="0dp"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:id="@+id/this_year_ctxv"
                android:textColor="@color/grey_hex_c7"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="right|center_vertical" />

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/date_type_rcv"
            android:layout_below="@+id/tab_rlay"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/date_type_rcv"
            android:background="@color/grey_hex_f8"
            android:id="@+id/my_sessions_top_llay"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/upper_rlay"
                android:padding="5dp"
                android:background="@color/grey_hex_f8">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.client.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:id="@+id/session_no_ctxv"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:text="00"/>

                    <com.pacifyr.client.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/black"
                        android:text="@string/sessions"/>


                </LinearLayout>



                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:id="@+id/hours_no_ctxv"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="00"/>

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:textColor="@color/black"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:text="@string/hrs"/>

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:id="@+id/minutes_no_ctxv"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="00"/>

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:textColor="@color/black"
                            android:text="@string/mns"/>

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.client.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:id="@+id/earnings_no_ctxv"
                        android:text="00"/>

                    <com.pacifyr.client.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:text="@string/earnings"/>
                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/grey_hex_e6"/>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/red_light_back"
            android:layout_below="@+id/my_sessions_top_llay"
            android:gravity="center"
            android:padding="8dp"
            android:id="@+id/missed_rlay">

            <LinearLayout
                android:id="@+id/linear_unread_missed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_alignParentLeft="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/redmissedsmall"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/red_missed_txt"
                    android:textStyle="bold"
                    android:id="@+id/missed_call_ctxv"
                    android:text=""/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_unread_declined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_alignParentRight="true">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/redcallsmall"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:id="@+id/declined_call_ctxv"
                    android:textColor="@color/red_missed_txt"
                    android:textStyle="bold"
                    android:text=""/>
            </LinearLayout>


        </RelativeLayout>

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/no_data_ctxv"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:visibility="gone"
            android:text=""
            android:gravity="center"/>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedscrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_below="@+id/missed_rlay"
            android:background="@color/white"
            android:scrollbars="none">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/my_sessions_rcv"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/month_sessions_rcv"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/year_sessions_rcv"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:id="@+id/unread_sessions_rcv"/>

    </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

</FrameLayout>
