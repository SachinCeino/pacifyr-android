<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="25dp"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.pacifyr.client.customview.MainTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="@color/grey_dark_text"
        android:text="@string/lest_us_know" />

    <com.pacifyrapp.utilitylibrary.CustomEditText
        android:id="@+id/message_edt"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="40dp"
        android:ems="10"
        android:lines="7"
        android:scrollbars="vertical"
        android:padding="15dp"
        android:hint="@string/question_or_issue"
        android:gravity="top|left"
        android:background="@drawable/rounded_white"
        android:inputType="textCapSentences|textMultiLine" />

    <RelativeLayout

        android:layout_gravity="center"
        android:id="@+id/send_rlay"
        android:layout_width="match_parent"
        android:layout_marginTop="40dp"
        android:layout_height="43dp"
        android:background="@drawable/blue_round_square">

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:id="@+id/send_msg_ctxv"
            android:textSize="20sp"
            android:textColor="@color/white" />

    </RelativeLayout>


</LinearLayout>
