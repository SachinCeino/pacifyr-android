<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawer_layout_pacifyr">

    <!--<com.ceino.shalomworld.Adapter.PagerEnabledSlidingPaneLayout-->
    <com.pacifyr.omhealthcare.utils.PagerEnabledSlidingPaneLayout
        android:id="@+id/pacifyr_sliding_pane"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!--First child is the left pane-->
        <!-- android:layout_marginRight="100dp"-->
        <LinearLayout
            android:id="@+id/left_pane"
            android:background="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:id="@+id/detail_llay">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_cimv"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/placeholder_user"/>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/account_rlay"
                    android:layout_marginLeft="5dp">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:id="@+id/detail_name_ctxv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="15sp"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:id="@+id/detail_mail_ctxv"
                        android:layout_below="@+id/detail_name_ctxv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="12sp"/>

                </RelativeLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/dashboard_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/dashboard_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/ic_dashboard_menu"
                    android:layout_centerInParent="true"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/dashboard_ctxv"
                    android:layout_width="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_height="wrap_content"
                    android:text="@string/my_dashboard"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/mysessions_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/mesessions_dimv"
                    android:layout_width="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_session_menu"
                    android:layout_centerInParent="true"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/mysessions_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/my_session"
                    android:layout_marginLeft="10dp"
                    android:layout_centerInParent="true"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/payment_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/payment_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/earningsnew"
                    android:layout_centerInParent="true"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/payment_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/payout"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/earnings_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/earnings_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/ic_earnings"
                    android:layout_centerInParent="true"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/earnings_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/earnings"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/mssages_llay"
                android:padding="10dp"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/mssages_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/message2"
                    android:layout_centerInParent="true"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/mssages_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/message"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>




            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/support_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/spport_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/support2"
                    android:layout_centerInParent="true" />

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/spport_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/support"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/policy_document_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/policy_document_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/ic_policy"
                    android:layout_centerInParent="true"
                    />

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/policy_document_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/policy_document"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/logout_llay"
                android:padding="10dp"
                android:gravity="center"
                android:orientation="horizontal">
                <!--    android:paddingRight="10dp"-->

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:id="@+id/logout_dimv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:width_percentage="10"
                    android:src="@drawable/ic_logout_menu"
                    android:layout_centerInParent="true"
                    />

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/logout_ctxv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/logout"
                    android:textColor="@color/black"
                    android:textSize="15sp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"/>


        </LinearLayout>
        <!--<fragment android:name="TestFragment"
            android:id="@+id/left_pane"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"/>-->

        <!--This second child is the right content pane-->
        <!--     <FrameLayout
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 android:background="@android:color/white">-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include layout="@layout/actionbar_three_text_image"
                android:id="@+id/include"
                android:layout_height="50dp"
                android:layout_width="match_parent"></include>

            <FrameLayout
                android:id="@+id/pacifyr_content_fragment"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">

            </FrameLayout>

        </LinearLayout>
        <!--
        </FrameLayout>-->
    </com.pacifyr.omhealthcare.utils.PagerEnabledSlidingPaneLayout>

</RelativeLayout>
