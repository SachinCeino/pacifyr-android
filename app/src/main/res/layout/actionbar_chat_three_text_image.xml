<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/action_bar_top_llay"
    android:layout_height="match_parent"
    android:background="@drawable/gray_actionbar_background"
    android:orientation="vertical"
    >


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottom_panel"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/left_llay"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="40dp"
                android:id="@+id/user_cimv"
                android:layout_height="40dp"
                android:src="@drawable/placeholder_user"

                app:width_percentage="8"
                app:parameter="aspect_width"
                android:padding="3dp"
                android:tint="@color/white"
                android:visibility="gone"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_alignParentStart="true" />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/user_cimv"
                android:id="@+id/left_txv"
                android:paddingLeft="10dp"
                android:textSize="@dimen/sp18"
                android:visibility="gone"
                android:text=""
                android:layout_centerVertical="true"
                android:textColor="@color/_color_action_bar_text_color"
                />
        </LinearLayout>

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/left_llay"
            android:layout_toLeftOf="@+id/right_llay"
            android:maxLines="1"
            android:maxLength="25"
            android:ellipsize="end"
            android:layout_centerInParent="true"
            android:text=""
            android:padding="5dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/sp20_title"
            android:id="@+id/title_txv"
            android:textColor="@color/_color_action_bar_text_color"
            />
        <!--  app:font="@string/avenir_roman"-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/right_llay"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingRight="5dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/right_imv"
                android:id="@+id/right_txv"
                android:paddingRight="2dp"
                android:textSize="@dimen/sp18"
                android:text=""
                android:textColor="@color/_color_action_bar_text_color"
                android:layout_centerVertical="true"
                />
            <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                android:layout_width="wrap_content"
                android:id="@+id/right_imv"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:width_percentage="7"
                android:layout_marginRight="4dp"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"/>
            <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                 android:layout_width="wrap_content"
                 android:id="@+id/right2_dimv"
                 android:layout_height="wrap_content"
                 android:visibility="gone"
                 app:width_percentage="7"
                 android:src="@drawable/icon_preferences"
                 android:layout_marginRight="5dp"

                 android:layout_centerVertical="true"
                 android:layout_centerHorizontal="true"
                 android:layout_alignParentEnd="true" />-->

        </LinearLayout>
    </RelativeLayout>
</LinearLayout>