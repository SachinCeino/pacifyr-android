<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/top_llay"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/user_cimv"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/placeholder_user" />


        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blue_text_dark"
                android:id="@+id/name_user_ctxv"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:id="@+id/call_type_img"
                    android:src="@drawable/ic_video_cam_blue"/>

                <com.pacifyr.omhealthcare.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:id="@+id/missed_ctxv"
                    android:textColor="@color/md_red_A200"
                    android:text="Missed Call"/>

            </LinearLayout>


            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="01-03-2018 10.27 am"
                android:textColor="@color/grey_hex_7c"
                android:id="@+id/date_ctxv"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|right"
            android:layout_marginRight="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_imv"
                android:tintMode="src_in"
                android:tint="@color/colorPrimary"
                android:src="@drawable/ic_message_blue"/>

        </LinearLayout>




    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/top_llay"
        android:background="#cac8cd"/>

<!--
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/top_llay"
        android:background="#cac8cd"/>
-->


</RelativeLayout>