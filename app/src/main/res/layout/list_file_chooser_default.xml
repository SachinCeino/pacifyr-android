<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:padding="10dp"
    android:id="@+id/file_llay">

    <ImageView
        android:id="@+id/add_document_imv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/files_rcv"
        android:layout_centerHorizontal="true"
        android:background="@drawable/dotted_black_line"
        android:padding="10dp"
        android:src="@drawable/adddocument2" />

    <com.pacifyr.client.customview.MainTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_marginTop="6dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/add_document_imv"
        android:id="@+id/file_name_ctxv"/>

</RelativeLayout>