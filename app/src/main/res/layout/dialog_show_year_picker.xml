<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:jp="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CustomNoActionBarTheme"
    android:layout_height="wrap_content"
    android:background="@drawable/white_round_square"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:padding="10dp"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="8dp"
                android:textColor="#000000"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:id="@+id/select_year_txv"
                android:text="Select year of birth"
                android:textSize="15sp"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/close_dimv"
                android:scaleType="fitXY"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_clear_black_24dp"/>

        </RelativeLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--<de.hdodenhof.circleimageview.CircleImageView
                android:layout_height="70dp"
                android:layout_width="70dp"
                android:layout_gravity="center"
                android:id="@+id/image_dialog_icon"
                android:src="@drawable/placeholder_user"/>-->
           <!-- <NumberPicker
                android:id="@+id/number_pickers"
                android:layout_width="100dp"
                android:layout_gravity="center"
                android:layout_height="100dp"></NumberPicker>-->

            <com.aigestudio.wheelpicker.widgets.WheelYearPicker
                android:id="@+id/wheel_date_picker_year"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"
                app:wheel_visible_item_count="5"
                app:wheel_curved="true"
                android:layout_below="@+id/phone_llay"/>



        </LinearLayout>





        <android.support.constraint.ConstraintLayout

            android:layout_gravity="center"
            android:id="@+id/save_rlay"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:padding="3dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/cancel_ctxv"
                android:layout_width="80dp"
                android:gravity="center"
                android:layout_height="30dp"
                android:background="@drawable/blue_border_white_background_solid"
                android:layout_marginStart="50dp"
                android:layout_marginTop="24dp"
                android:text="Cancel"
                android:textColor="#3F51B5"
                android:textSize="@dimen/sp15"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                jp:ignore="MissingConstraints" />


            <TextView
                android:id="@+id/save_ctxv"
                android:layout_width="80dp"
                android:gravity="center"
                android:layout_height="30dp"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="24dp"
                android:text="Save"
                android:background="@drawable/blue_border_white_background_solid"
                android:textColor="#3F51B5"
                android:textSize="@dimen/sp15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.591"
                app:layout_constraintStart_toEndOf="@+id/cancel_ctxv"
                app:layout_constraintTop_toTopOf="parent" />

        </android.support.constraint.ConstraintLayout>


    </LinearLayout>

</RelativeLayout>


