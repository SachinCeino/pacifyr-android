            android:numStars="5"
            android:rating="5"
            android:secondaryProgressTint="@color/md_red_50"
            android:stepSize="1.0" />-->



    </RelativeLayout>



    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray" />

</LinearLayout>

