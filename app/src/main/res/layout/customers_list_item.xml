<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:visibility="visible"
    android:id="@+id/top_llay"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:padding="10dp"
        android:id="@+id/customer_top_rlay"
        android:layout_height="wrap_content">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="5dp"
            android:id="@+id/customer_cimv"
            android:src="@drawable/placeholder_user"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toRightOf="@+id/customer_cimv"
            android:layout_marginLeft="20dp">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/customer_name_ctxv"
                android:text=""/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/grey_hex_57"
                android:textSize="14sp"/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/grey_hex_57"
                android:id="@+id/customer_wallet_ctxv"
                android:textSize="14sp"
                android:text=""/>

        </LinearLayout>

        <ImageView
            android:id="@+id/chat_imv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:visibility="visible"
            android:layout_marginTop="13dp"
            android:layout_marginRight="10dp"
            android:tint="@color/blue_pacifyr"
            android:src="@drawable/message2"/>



       <!-- <com.willy.ratingbar.BaseRatingBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/customer_rating"
            android:layout_marginLeft="20dp">

        </com.willy.ratingbar.BaseRatingBar>-->

       <!-- <RatingBar
            android:layout_width="wrap_content"
            android:rating="0"
            android:id="@+id/customer_rating"
            android:layout_marginLeft="20dp"
            android:layout_gravity="center"
