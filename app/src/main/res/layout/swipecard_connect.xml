<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:background="@drawable/white_round_square"
    android:layout_height="wrap_content">

<!--android:background="@color/grey_hex_e6"-->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_pacifyr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        card_view:cardCornerRadius="0dp"
        card_view:contentPadding="0dp"
        android:foregroundGravity="center"
        card_view:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:id="@+id/img_prof"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_user"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:id="@+id/indicator_dimv"
                            android:src="@drawable/offline"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/indicator_ctxv"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_marginLeft="7dp"
                            android:textColor="@color/grey_dark"
                            android:text="@string/offline"/>

                    </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:id="@+id/rlay_first">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/linear_text"
                    android:padding="2dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_name"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_text_dark"
                            android:text=""/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/grey_dark"
                            android:id="@+id/specialities_ctxv"
                            android:maxLines="3"
                        android:textSize="12sp"
                            android:text=""/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="3dp"
                            android:gravity="center"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatRatingBar
                                android:id="@+id/myRatingBar"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:progressTint="@color/blue_text_dark"
                                android:isIndicator="true"/>

                            <com.pacifyr.omhealthcare.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="88 Reviews"
                                android:id="@+id/item_review_tv"
                                android:layout_marginLeft="5dp"
                                android:textColor="@color/blue_text_dark"
                                android:textSize="12sp" />

                        </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:gravity="left">

                        <!--<com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  "
                            android:gravity="right"
                            android:id="@+id/doller_sign_ctxv"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>-->

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:gravity="left"
                            android:layout_gravity="left"
                            android:id="@+id/price_dollar"
                            android:textColor="@color/colorPrimary"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <!-- <com.pacifyr.omhealthcare.customview.MainTextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="  per hour"
                             android:gravity="right"
                             android:id="@+id/perhour_ctxv"
                             android:textColor="@color/white"
                             android:textSize="13sp"/>-->

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/chat_llay"
                        android:background="@drawable/white_round_square"
                        android:padding="5dp">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:id="@+id/chat_price_ctxv"
                            android:textColor="@color/blue_text_dark"
                            android:textAlignment="center"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="10dp"
        android:layout_below="@+id/card_pacifyr">

        <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textSize="15sp"
            android:padding="7dp"
            android:id="@+id/description_ctxv"
            android:textColor="@color/grey_hex_4a"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:layout_below="@+id/description_ctxv"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="10dp"
                android:id="@+id/videocall_rlay"
                android:background="@drawable/primary_cirlce">

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:height_percentage="9"
                    app:parameter="aspect_width"
                    app:width_percentage="8"
                    app:aspect_ratio="1"
                    android:scaleType="fitCenter"
                    android:layout_centerInParent="true"
                    android:id="@+id/start_video_cimv"
                    android:src="@drawable/ic_video_white_2" />

            </RelativeLayout>
      <!--      <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                android:id="@+id/start_video_cimv"
                android:src="@drawable/ic_video_white_2"
                android:background="@color/blue_pacifyr"/>-->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginLeft="25dp"
                android:id="@+id/audiocall_rlay"
                android:background="@drawable/primary_cirlce">

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:height_percentage="9"
                    app:parameter="aspect_width"
                    app:width_percentage="8"
                    app:aspect_ratio="1"
                    android:scaleType="fitCenter"
                    android:id="@+id/start_audio_cimv"
                    android:layout_centerInParent="true"
                    android:src="@drawable/connectaudio2" />

            </RelativeLayout>


  <!--          <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:id="@+id/start_audio_cimv"
                android:layout_marginLeft="25dp"
                android:layout_centerInParent="true"
                android:src="@drawable/connectaudio2"
                android:background="@color/blue_pacifyr"/>-->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="10dp"
                android:visibility="visible"
                android:layout_marginLeft="25dp"
                android:id="@+id/chat_rlay"
                android:background="@drawable/primary_cirlce">

                <com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/start_chat_cimv"
                    app:height_percentage="9"
                    app:parameter="aspect_width"
                    app:width_percentage="8"
                    app:aspect_ratio="1"
                    android:scaleType="fitCenter"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_chat_white" />

            </RelativeLayout>
          <!--  <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/blue_pacifyr"
                android:id="@+id/start_chat_cimv"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                android:layout_marginLeft="25dp"
                android:src="@drawable/ic_chat_white"
                android:background="@color/blue_pacifyr"/>-->

        </LinearLayout>
        <!-- <com.pacifyr.omhealthcare.customview.MainTextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="@string/connect_pacifyr"
             android:padding="5dp"
             android:gravity="center"
             android:layout_marginTop="15dp"
             android:layout_below="@+id/description_ctxv"
             android:id="@+id/connect_pacifyr_ctxv"
             android:layout_centerInParent="true"
             android:textSize="13sp"
             android:background="@drawable/blue_border_white_background_round"
             android:textColor="@color/colorPrimary"/>-->


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/description_ctxv"
            android:orientation="horizontal">


        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>
