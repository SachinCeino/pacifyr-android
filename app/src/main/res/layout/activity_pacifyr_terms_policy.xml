<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="30dp"
                android:gravity="center"
                android:id="@+id/top_llay"
                android:orientation="vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/placeholder_user"
                    android:id="@+id/profile_image_cimv"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:id="@+id/profile_name_ctxv"/>

            </LinearLayout>


            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_below="@+id/top_llay"
                android:textStyle="bold"
                android:padding="10dp"
                android:text="Please review and accept the terms and agrements"
                android:textColor="@color/black"
                android:id="@+id/please_ctxv"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="5dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/terms_cbox"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/terms_ctxv"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/blue_pacifyr"
                    android:text="@string/term_of_use2"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:padding="5dp"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/privacy_cbox"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/privacy_ctxv"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/blue_pacifyr"
                    android:text="@string/privacy_policy"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:padding="5dp"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/agreement_cbox"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/agreement_ctxv"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/blue_pacifyr"
                    android:text="@string/bussines_agrement"/>

            </LinearLayout>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/submit_ctxv"
                android:padding="5dp"
                android:clickable="false"
                android:gravity="center_horizontal"
                android:background="@drawable/disabled_blue_backround"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="20sp"/>



        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
