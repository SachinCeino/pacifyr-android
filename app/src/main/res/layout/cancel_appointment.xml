<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_margin="20dp"
        android:id="@+id/close_dialogue"
        android:src="@drawable/cross_close"
        ></ImageView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="25dp"
        android:orientation="vertical">
        <com.pacifyr.client.customview.MainTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="20sp"
            android:id="@+id/title"
            android:textColor="@color/black"
            android:text="" />

        <EditText
            android:id="@+id/message_edt"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            android:ems="10"
            android:padding="15dp"
            android:lines="7"
            android:textColorHighlight="@color/text_Color_High_light"
            android:scrollbars="vertical"
            android:gravity="top|left"
            android:background="@drawable/rounded_white"
            android:inputType="textCapSentences|textMultiLine" />

        <LinearLayout

            android:layout_gravity="center"
            android:id="@+id/close_layout"
            android:layout_width="335dp"
            android:layout_marginTop="20dp"
            android:layout_height="43dp"
            android:background="@drawable/blue_border_lightblue">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:gravity="center"
                android:id="@+id/send_msg_ctxv"
                android:textSize="20sp"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
