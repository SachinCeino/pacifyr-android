<!-- A DrawerLayout is intended to be used as the top-level content view using match_parent for both width and height to consume the full space available. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:swipedeck="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F8F8">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/searchLayout"
                android:orientation="horizontal"
                android:layout_margin="15dp"
                android:layout_below="@+id/include"
                android:background="@drawable/resource_search_background"
                >
                <SearchView
                    android:id="@+id/pacifyr_SearchView"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:inputType="textCapSentences"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch"
                    android:queryHint="@string/query_hint_search_pacifyr"
                    />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/query_hint_search_pacifyr"
                    android:layout_marginLeft="50dp"
                    android:focusable="false"
                    android:id="@+id/EditText_search"
                    ></EditText>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rlay_search"
                android:layout_below="@id/include">

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/tv_search"
                    android:text="@string/select_specialisation"
                    android:textColor="@color/cardview_dark_background"
                    android:layout_width="wrap_content"
                    android:textSize="18dp"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true" />



                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal"
                    android:id="@+id/special_recycle"
                    android:layout_below="@+id/tv_search">

                </androidx.recyclerview.widget.RecyclerView>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/showall_llay"
                android:gravity="end"
                android:layout_below="@id/rlay_search"
                android:layout_marginEnd="30dp"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/showall_cbox"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/showall_ctxv"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/show_all"/>

            </LinearLayout>


            <com.daprlabs.cardstack.SwipeDeck
                android:layout_marginBottom="@dimen/sp15"
                android:id="@+id/swipe_deck"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="20dp"
                android:layout_below="@id/showall_llay"
                swipedeck:card_spacing="10dp"
                swipedeck:max_visible="3"
                swipedeck:render_above="true"
                swipedeck:rotation_degrees="15" />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="match_parent"
                android:gravity="center"
                android:id="@+id/no_pacifyr_ctxv"
                android:visibility="gone"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:text="@string/no_wellness_experts_category"
                android:layout_height="match_parent" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
