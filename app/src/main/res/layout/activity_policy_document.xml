<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/top_llay"
        android:layout_below="@+id/include"
        android:orientation="vertical">

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="18sp"
            android:id="@+id/terms_ctxv"
            android:layout_marginLeft="10dp"
            android:textColor="@color/black"
            android:text="@string/terms_of_use"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_hex_c5"/>


        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:id="@+id/privacy_ctxv"
            android:textSize="18sp"
            android:layout_marginLeft="10dp"
            android:textColor="@color/black"
            android:text="@string/privacy_policy"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_hex_c5"/>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textSize="18sp"
            android:id="@+id/copyright_ctxv"
            android:layout_marginLeft="10dp"
            android:textColor="@color/black"
            android:text="@string/copyright_dispute_policy"/>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey_hex_c5"/>

    </LinearLayout>

</RelativeLayout>
