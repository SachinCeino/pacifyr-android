<!-- A DrawerLayout is intended to be used as the top-level content view using match_parent for both width and height to consume the full space available. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.pacifyr.omhealthcare.home.ListPacifyrScreenActivity">

    <!-- As the main content view, the view below consumes the entire
         space available using match_parent in both dimensions. -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The drawer is given a fixed width in dp and extends the full height of
         the container. -->
    <!--    <fragment
            android:id="@+id/navigation_drawer"
            android:name="com.pacifyr.pacifyrapp.sign.NavigationDrawerFragment"
            android:layout_width="@dimen/navigation_drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            tools:layout="@layout/drawer_home_screen" />-->

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:swipedeck="http://schemas.android.com/apk/res-auto"
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:background="#F8F8F8">

        <include layout="@layout/actionbar_grey"
            android:id="@+id/include"
            android:layout_height="50dp"
            android:layout_width="match_parent"></include>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_below="@id/include">

            <SearchView
                android:id="@+id/pacifyr_SearchView"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#f1f1f1"
                android:queryHint="@string/query_hint_search_pacifyr"
                />
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rlay_search"
                android:layout_below="@id/include">

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/tv_search"
                    android:text="@string/select_specialisation"
                    android:textColor="@color/cardview_dark_background"
                    android:layout_width="wrap_content"
                    android:textSize="18dp"
                    android:padding="16dp"
                    android:layout_marginBottom="10dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true" />

                <!--  <com.ceino.utilitylibrary.CustomFontTextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:id="@+id/tv_search"
                      android:layout_marginLeft="10dp"
                      android:text="Search for a Pacifyr"/>-->


                <android.support.v7.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:orientation="horizontal"
                    android:id="@+id/special_recycle"
                    android:layout_below="@+id/tv_search">

                </android.support.v7.widget.RecyclerView>

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:id="@+id/showall_llay"
                android:gravity="right"
                android:layout_below="@id/rlay_search"
                android:layout_marginRight="30dp"
                android:orientation="horizontal">

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/showall_cbox"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/showall_ctxv"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/show_all"/>

            </LinearLayout>


            <com.daprlabs.cardstack.SwipeDeck
                android:id="@+id/swipe_deck"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:padding="20dp"
                android:layout_below="@id/showall_llay"
                swipedeck:card_spacing="10dp"
                swipedeck:max_visible="3"
                swipedeck:render_above="true"
                swipedeck:rotation_degrees="15" />

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:gravity="center"
                android:id="@+id/no_pacifyr_ctxv"
                android:visibility="gone"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:text="@string/no_wellness_experts_category"
                android:layout_height="match_parent" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
