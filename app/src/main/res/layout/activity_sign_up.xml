<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent">
    </include>


    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp">

        <ImageView
            android:id="@+id/logo_blue"
            android:layout_width="200dp"
            android:layout_height="160dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:src="@drawable/powered_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/email_login_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/logo_rlay"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="5dp"
            app:layout_constraintEnd_toEndOf="@+id/logo_blue"
            app:layout_constraintStart_toStartOf="@+id/logo_blue"
            app:layout_constraintTop_toBottomOf="@+id/logo_blue"
            app:layout_marginTopPercent="10%">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:id="@+id/enter_phone_ctxv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/e_phonenumber"
                android:textColor="@color/_color_enter_phone_ctxv"
                android:textSize="17sp"
                app:fontName="@string/raleway_bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <!--<com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/textView"
                    android:layout_below="@+id/textView" />


                <com.ceino.utilitylibrary.CustomEditText
                    android:id="@+id/phone_cedit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:hint="@string/phone"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:textColorHint="@color/phone_grey"
                    android:textSize="@dimen/sp17" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/signup_view" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/llay_confo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/email_login_form"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="@+id/email_login_form"
            app:layout_constraintStart_toStartOf="@+id/email_login_form"
            app:layout_constraintTop_toBottomOf="@+id/email_login_form"
            app:layout_marginBottomPercent="5%">


            <RelativeLayout

                android:id="@+id/request_rlay"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:background="@drawable/blue_border_lightblue"
                android:padding="10dp">

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/request_ctxv"
                    android:layout_width="wrap_content"
                    app:fontName="@string/avanti_std_bk"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:text="@string/send_confirmcode"
                    android:textColor="@color/white"
                    android:textSize="18sp" />


            </RelativeLayout>

            <com.facebook.login.widget.LoginButton
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:visibility="gone" />

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/sms_text_login"
                android:textColor="@color/grey_dark"
                android:textSize="@dimen/sp12" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_below="@+id/laly_top_send"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/laly_top_send"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="180dp"
                    android:layout_height="1dp"
                    android:background="@color/signup_view" />

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:text="or"
                    android:textColor="@color/_color_or_text"
                    android:textSize="@dimen/sp16" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="1dp"
                    android:background="@color/signup_view" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/facebook_rlay"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:background="@drawable/fb_signup_btn"
                android:padding="10dp">

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:id="@+id/fb_tcv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    app:fontName="@string/avanti_std_bk"
                    android:text="@string/signup_fb"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="25dp"
                    android:layout_marginRight="5dp"
                    android:padding="3dp"
                    android:src="@drawable/facebook" />

            </RelativeLayout>

        </LinearLayout>



    </android.support.constraint.ConstraintLayout>


</LinearLayout>