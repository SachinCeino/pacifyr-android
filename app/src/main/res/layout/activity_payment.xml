<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent"></include>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">


        <com.pacifyr.omhealthcare.customview.MainTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/payment_method_ctxv"
        android:textColor="@color/text_dashboard"
        android:text="PAYMENT METHOD"/>


        <com.pacifyr.omhealthcare.customview.MainTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:textSize="15sp"
        android:id="@+id/credict_card_ctxv"
        android:layout_marginTop="23dp"
        android:textStyle="bold"
        android:visibility="visible"
        android:textColor="@color/colorPrimary"
        android:text="Add Credit Card"/>

        <androidx.recyclerview.widget.RecyclerView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/card_rcv"
        android:layout_marginTop="23dp"
        android:visibility="gone"></androidx.recyclerview.widget.RecyclerView>

    </LinearLayout>

</LinearLayout>
