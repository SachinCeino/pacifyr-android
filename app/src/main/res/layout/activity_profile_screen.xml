<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/prof_top_rlay"
    xmlns:card_view="http://schemas.android.com/apk/res-auto">

    <include layout="@layout/actionbar_three_text_image"
        android:id="@+id/include"
        android:layout_height="?attr/actionBarSize"
        android:layout_width="match_parent"></include>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_below="@+id/include"
        android:padding="10dp"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        android:id="@+id/profile_llay">



            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18dp"
                android:textColor="@color/blue_text_dark"
                android:textAlignment="center"
                android:id="@+id/profile_name_ctxv"
                android:text="Pacifyr Name"/>


        <!-- <com.ceino.utilitylibrary.CustomFontTextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:textSize="12dp"
             android:textColor="@color/white"
             android:textAlignment="center"
             android:id="@+id/pacifyr_role_ctxv"
             android:text="Pacifyr"/>
-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/profile_rating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="3.5"
                android:isIndicator="true" />

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/rating_ctxv"
                android:text="88 Reviews"/>

        </LinearLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/profile_cimv"
            android:src="@drawable/placeholder_user"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/online_offline_imv"
            android:src="@drawable/offline"/>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8dp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:id="@+id/isonline_ctxv"
            android:text="OFFLINE"/>

    </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="3dp"
            android:id="@+id/chat_price_layout"
            android:orientation="horizontal">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/dollar_sign_ctxv"
                android:text=""/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/price_ctxv"
                android:text="1000"/>

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/per_hour_ctxv"
                android:text="@string/per_hour"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:id="@+id/chat_llay"
            android:visibility="gone"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/primary_background_white_border"
            android:padding="5dp">

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:id="@+id/chat_price_ctxv"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textSize="15sp"/>

        </LinearLayout>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Connect_to_Wellness_Experts"
            android:padding="7dp"
            android:id="@+id/connect_pacifyr_ctxv"
            android:layout_centerInParent="true"
            android:textSize="13sp"
            android:background="@drawable/blue_round_square"
            android:textColor="@color/white"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:id="@+id/call_llay"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:tint="@color/white"
                android:id="@+id/start_video_cimv"
                android:src="@drawable/ic_video_white_2"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:tint="@color/white"
                android:id="@+id/start_audio_cimv"
                android:layout_marginLeft="25dp"
                android:src="@drawable/connectaudio2" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/white"
                android:visibility="gone"
                android:id="@+id/start_chat_cimv"
                android:scaleType="centerCrop"
                android:layout_marginLeft="25dp"
                android:src="@drawable/ic_chat_white"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/white"
                android:id="@+id/schedule_rlay"
                android:layout_marginLeft="25dp"
                android:layout_gravity="top"
                card_view:srcCompat="@drawable/ic_schedule" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/profile_llay">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/snapshot_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="SNAP SHOT"/>


                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginBottom="10dp"
                        android:id="@+id/snapshot_ctxv"
                        android:textColor="@color/education_desc"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/blog_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="BLOG OR WEBSITE"/>


                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_centerHorizontal="true"
                        android:id="@+id/website_ctxv"
                        android:textColor="@color/education_desc"
                        android:text=""/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:id="@+id/speciality_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="AREAS OF SPECIALITY"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/special_rcv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/special_list_ctxv"
                        android:textColor="@color/education_desc"
                        android:textSize="@dimen/sp11"/>

                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:id="@+id/education_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="EDUCATION"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/education_rcv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/certification_card"
                android:layout_margin="20dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="CERTIFICATIONS"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/certification_rcv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>


                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
