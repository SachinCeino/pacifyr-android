<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:swipedeck="http://schemas.android.com/apk/res-auto">

    <include layout="@layout/actionbar_grey_close"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent">
    </include>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_below="@+id/include"
        android:elevation="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/top_rlay">

        <com.pacifyr.omhealthcare.customview.MainTextView
            android:id="@+id/text_feel_ctxv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="Get ready to feel better!"
            android:textColor="@color/grey_dark"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:id="@+id/view_line"
            android:layout_below="@+id/text_feel_ctxv"
            android:layout_height="4dp"
            android:background="@color/grey_dark"/>

        <Button
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/view_line"
            android:layout_marginTop="-20dp"
            android:id="@+id/button1"
            android:text="1"
            android:clickable="false"
            android:textColor="@color/white"
            android:layout_marginLeft="50dp"
            android:background="@drawable/circle_click_btn"/>


        <Button
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/view_line"
            android:layout_marginTop="-20dp"
            android:id="@+id/button2"
            android:text="2"
            android:textColor="@color/white"
            android:clickable="false"
            android:layout_marginLeft="130dp"
            android:background="@drawable/circle_button"/>

        <Button
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/view_line"
            android:layout_marginTop="-20dp"
            android:id="@+id/button3"
            android:text="3"
            android:textColor="@color/white"
            android:clickable="false"
            android:layout_marginLeft="210dp"
            android:background="@drawable/circle_button"/>

        <Button
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_below="@+id/view_line"
            android:layout_marginTop="-20dp"
            android:id="@+id/button4"
            android:text="4"
            android:textColor="@color/white"
            android:clickable="false"
            android:layout_marginLeft="290dp"
            android:background="@drawable/circle_button"/>

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_below="@+id/top_rlay"
        android:id="@+id/container_fragment_main">

    </FrameLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:layout_marginTop="-17dp"
        android:elevation="0dp"
        android:layout_below="@+id/top_rlay"
        android:id="@+id/select_feeling_rlay"
        android:background="#F0F3F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/colorPrimary"
                android:id="@+id/user_name_ctxv"
                android:text="Hello"/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/grey_dark"
                android:text="@string/how_you_feel_now"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:id="@+id/sad_llay"
                    android:orientation="vertical"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="0dp"
                    android:gravity="center"
                    android:layout_height="wrap_content">

                    <com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:id="@+id/sad_dimv"
                        android:layout_gravity="center_horizontal"
                        android:tint="@color/grey_dark"
                        android:src="@drawable/sad"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="match_parent"
                        android:textAlignment="center"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/sad_dimv"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/grey_dark"
                        android:layout_gravity="center_horizontal"
                        android:text="A bit down"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_toRightOf="@id/sad_llay"
                    android:layout_marginLeft="20dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_height="wrap_content">
                    <com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:id="@+id/happy_dimv"
                        android:tint="@color/grey_dark"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/happy"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/grey_dark"
                        android:text="Good"/>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <com.pacifyr.omhealthcare.customview.MainTextView
            android:visibility="gone"
            android:id="@+id/txt_emergency_usa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/black"
            android:layout_marginBottom="30dp"
            android:layout_alignParentBottom="true"
            android:text="@string/call_emergency"/>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_marginTop="-17dp"
        android:layout_below="@+id/top_rlay"
        android:id="@+id/select_emotion_rlay"
        android:background="#F0F3F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/grey_hex_83"
                android:text="Tell me more"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/emotion_rcv"/>

                </LinearLayout>




        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_marginTop="-17dp"
        android:layout_below="@+id/top_rlay"
        android:id="@+id/select_emotion_detail_rlay"
        android:background="#F0F3F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:id="@+id/why_feeling_ctxv"
                android:textColor="@color/grey_hex_8f"
                android:text="Why are you feeling"/>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp20"
                android:id="@+id/emotion_detail_rcv"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

            </androidx.recyclerview.widget.RecyclerView>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/more_button"
                android:textColor="@color/colorPrimary"
                android:background="@android:color/transparent"
                android:text="More"/>

        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/top_rlay"
        android:id="@+id/select_list_pacifyr_rlay"
        android:background="#F0F3F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:visibility="gone"
            android:id="@+id/showall_llay"
            android:gravity="right"
            android:layout_marginRight="30dp"
            android:orientation="horizontal">

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/showall_cbox"/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/showall_ctxv"
                android:layout_marginLeft="5dp"
                android:textColor="@color/colorPrimary"
                android:text="@string/show_all"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_below="@+id/showall_llay"
            android:layout_margin="5dp"
            android:gravity="center_horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/image_rcv">

            </androidx.recyclerview.widget.RecyclerView>

               <com.daprlabs.cardstack.SwipeDeck
                   android:id="@+id/swipe_deck"
                   android:layout_width="match_parent"
                   android:layout_height="350dp"
                   android:padding="5dp"
                   android:visibility="gone"
                   swipedeck:card_spacing="5dp"
                   swipedeck:max_visible="3"
                   swipedeck:render_above="true"
                   swipedeck:rotation_degrees="15" />

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/no_pacifyr_ctxv"
                android:visibility="gone"
                android:layout_marginTop="50dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/sp16"
                android:gravity="center"
                android:text="@string/no_pacifyr"/>



        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/more_pacifyrs_rlay"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:layout_marginBottom="25dp">

        <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/round_square_for_round_cuttons"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/more_wellness_experts"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </RelativeLayout>


</RelativeLayout>
