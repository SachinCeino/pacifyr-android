<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.pacifyr.omhealthcare.home.MySessionsActivity">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent"></include>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/include">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grey_background"
            android:id="@+id/my_sessions_top_llay"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="55dp">

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:id="@+id/this_wk_ctxv"
                    android:gravity="center"
                    android:padding="15dp"
                    android:background="@drawable/blue_line_bottom"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_pacifyr"
                    android:layout_alignParentLeft="true"
                    android:text="Weekly"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/this_mnt_ctxv"
                    android:gravity="center"
                    android:padding="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/grey_hex_c7"
                    android:textSize="18sp"
                    android:layout_centerHorizontal="true"
                    android:text="Monthly"/>

                <com.ceino.utilitylibrary.CustomFontTextView
                    android:layout_width="wrap_content"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/grey_hex_c7"
                    android:padding="15dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/this_year_ctxv"
                    android:textSize="18sp"
                    android:layout_alignParentRight="true"
                    android:text="Yearly"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/grey_hex_e6"/>


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:background="#F0F3F5"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginLeft="3dp"
                    android:visibility="gone"
                    android:src="@drawable/ic_arrow_back"
                    android:layout_centerVertical="true"/>

                <android.support.v7.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/date_list_rcv"/>

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_centerVertical="true"
                    android:visibility="gone"
                    android:layout_marginRight="3dp"
                    android:src="@drawable/ic_arrow_forword"
                    android:layout_alignParentRight="true"/>

            </RelativeLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/grey_hex_e6"/>



            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/upper_rlay"
                android:padding="5dp"
                android:background="#F0F3F5">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:id="@+id/session_no_ctxv"
                        android:textColor="@color/grey_dark_text"
                        android:textStyle="bold"
                        android:text="00"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/grey_dark_text"
                        android:text="@string/sessionS"/>


                </LinearLayout>



                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:id="@+id/hours_no_ctxv"
                            android:textColor="@color/grey_dark_text"
                            android:textStyle="bold"
                            android:text="00"/>

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:textColor="@color/grey_dark_text"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:text="@string/hrs"/>

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="25sp"
                            android:id="@+id/minutes_no_ctxv"
                            android:textColor="@color/grey_dark_text"
                            android:textStyle="bold"
                            android:text="00"/>

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="@string/mns"/>

                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_marginRight="15dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/grey_dark_text"
                        android:textStyle="bold"
                        android:id="@+id/earnings_no_ctxv"
                        android:text="00"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textColor="@color/grey_dark_text"
                        android:text="@string/paid"/>


                </LinearLayout>


            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/grey_hex_e6"/>








        </LinearLayout>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/no_data_ctxv"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:visibility="gone"
            android:text=""
            android:gravity="center"/>

        <android.support.v7.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:layout_below="@+id/my_sessions_top_llay"
            android:id="@+id/week_sessions_rcv">

        </android.support.v7.widget.RecyclerView>

        <android.support.v7.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/white"
            android:layout_below="@+id/my_sessions_top_llay"
            android:id="@+id/month_sessions_rcv">

        </android.support.v7.widget.RecyclerView>

        <android.support.v7.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/white"
            android:layout_below="@+id/my_sessions_top_llay"
            android:id="@+id/year_sessions_rcv">

        </android.support.v7.widget.RecyclerView>

    </RelativeLayout>

</RelativeLayout>
