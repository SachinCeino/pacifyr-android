<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentOpponents"
    style="@style/MatchParent"
    android:background="@color/background_fragment_conversation">


    <com.quickblox.videochat.webrtc.view.QBRTCSurfaceView
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        />
    <!--     android:layout_above="@+id/grid_opponents"-->
    <com.quickblox.videochat.webrtc.view.QBRTCSurfaceView
        android:id="@+id/local_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/element_set_video_buttons"
        android:layout_alignParentRight="true"

        android:layout_marginLeft="@dimen/margin_small"
        android:layout_marginTop="@dimen/action_bar_height"
        android:layout_marginBottom="10dp" />

    <include
        layout="@layout/view_outgoing_screen"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/info_overlay_llay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/user_rlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:padding="8dp">

            <com.pacifyr.client.customview.MainTextView
                android:id="@+id/call_ctxv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/video_call"
                android:textColor="@color/grey_fit"
                android:textSize="@dimen/sp16"
                android:textStyle="bold"
                android:visibility="visible" />

                <TextView
                    android:id="@+id/connectionStatusLocal"
                    style="@style/MatchWidth"
                    android:layout_below="@+id/call_ctxv"
                    android:layout_marginTop="10dp"
                    android:maxLength="13"
                    android:maxLines="1"
                    android:text="Ringing..."
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/blue_button_primary"
                    android:textStyle="normal" />



            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/connectionStatusLocal"
                android:layout_marginTop="100dp">
                <!--        <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:id="@+id/user_dimv"
                            app:width_percentage="12"
                android:background="@drawable/shape_circle"
                            android:visibility="visible"
                            app:height_percentage="10"
                            android:layout_centerVertical="true"
                            app:parameter="aspect_width"
                            app:aspect_ratio="1"

                            android:src="@drawable/placeholder_image"
                            android:layout_height="wrap_content" />-->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/user_dimv"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/placeholder_image"
                    android:visibility="gone"
                    app:aspect_ratio="1"
                    app:height_percentage="10"
                    app:parameter="aspect_width"
                    app:width_percentage="12" />

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/username_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@+id/user_dimv"
                    android:cursorVisible="false"
                    android:padding="5dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp18"
                    android:visibility="gone" />

            </RelativeLayout>

        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/emotion_rlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="5dp"
            android:background="@color/transparent"
            android:padding="8dp"
            android:visibility="gone">

            <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                android:id="@+id/emotion_dimv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="5dp"
                android:src="@drawable/placeholder_user"
                android:visibility="visible"
                app:aspect_ratio="1"
                app:height_percentage="10"
                app:parameter="aspect_width"
                app:width_percentage="15" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="4dp"
                android:layout_toRightOf="@+id/emotion_dimv"
                android:orientation="vertical">

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/emotion_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/reason_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:visibility="visible" />

            </LinearLayout>
        </RelativeLayout>


        <Chronometer
            android:id="@+id/chronometer_timer_video_call"
            style="@style/WrapContent"
            android:layout_width="wrap_content"
            android:layout_gravity="left"
            android:layout_margin="10dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/text_remaining_minutes"
            style="@style/WrapContent"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/blue_button_primary"
            android:textSize="@dimen/also_on_call_text_size" />

    </LinearLayout>
    <FrameLayout
        android:id="@+id/call_overlay_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_gravity="end"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:padding="10dp"
        >

        <ImageView
            android:id="@+id/toggle_Max_Min"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:src="@drawable/maximize_"></ImageView>

        <LinearLayout
            android:id="@+id/call_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toggle_Max_Min"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="50dp"
            android:background="@drawable/call_overlay_background"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_emotion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/confused" />
            </LinearLayout>

            <!--
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:id="@+id/ImageView_note"
                            android:padding="5dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/overlay_note" />
                        </LinearLayout>
            -->

            <LinearLayout
                android:id="@+id/more_rlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_more" />
            </LinearLayout>

                        <LinearLayout
                            android:id="@+id/certificate_View"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp">

                            <ImageView
                                android:id="@+id/ImageView_kyc"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/overlay_kyc" />
                        </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayout_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_chat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_chat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayout_prescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_prescription"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_prescription" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/grid_opponents_rlay"
        style="@style/WrapContent"
        android:layout_above="@+id/element_set_video_buttons"
        android:background="@color/background_fragment_conversation"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid_opponents"
            style="@style/WrapContent"
            android:layout_height="0dp"

            android:layout_marginBottom="@dimen/margin_common"
            android:horizontalSpacing="@dimen/margin_small"
            android:numColumns="3"

            android:verticalSpacing="@dimen/margin_small"

            tools:listitem="@layout/list_item_opponent_from_call">
            <!--  android:visibility="gone"-->
        </androidx.recyclerview.widget.RecyclerView>
        <!--    android:layout_above="@+id/element_set_video_buttons"-->
    </RelativeLayout>

    <include
        android:id="@+id/element_set_video_buttons"
        layout="@layout/view_action_buttons_conversation_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/billing_status"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/margin_common" />

    <com.pacifyr.client.customview.MainTextView
        android:id="@+id/billing_status"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="13dp"
        android:background="@drawable/white_border_transparent_black"
        android:enabled="false"
        android:padding="10dp"
        android:text="@string/start_session"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="invisible" />
    <!--  <View
          android:id="@+id/empty_stub"
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_alignParentBottom="true" />-->
</RelativeLayout>