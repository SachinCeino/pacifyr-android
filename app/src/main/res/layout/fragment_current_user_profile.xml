<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
          android:layout_marginBottom="10dp"

        android:padding="30dp"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        android:id="@+id/profile_llay">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/profile_cimv"
            android:src="@drawable/placeholder_user"/>
        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:id="@+id/profile_name_ctxv"
            android:text=""/>


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/profile_llay">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_light"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/mail_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">




                    <LinearLayout
                        android:id="@+id/mail_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/line1"
                        android:layout_toRightOf="@+id/avatar_dimv"
                        android:background="@color/white"
                        android:orientation="horizontal">
                        <com.ceino.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:height_percentage="8"
                            app:width_percentage="8"
                            app:parameter="fixed_ratio"
                            android:layout_marginRight="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/parent_mail_black"/>
                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:id="@+id/mail_dtxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text=""
                            android:textColor="@color/grey_dark_text"
                            android:textSize="@dimen/sp16"
                            app:percentage_height="8" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pnumber_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/mail_llay"
                        android:layout_marginTop="15dp"
                        android:layout_toRightOf="@+id/avatar_dimv"
                        android:background="@color/white"
                        android:orientation="horizontal">
                        <com.ceino.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:height_percentage="8"
                            app:width_percentage="8"
                            app:parameter="fixed_ratio"
                            android:layout_marginRight="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_call_grey"/>

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:id="@+id/pnumber_dtxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text="+91 "
                            android:textColor="@color/grey_dark_text"
                            android:textSize="@dimen/sp16"
                            app:percentage_height="8" />

                    </LinearLayout>


                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:id="@+id/aboutme_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/grey_dark_text"
                        android:text="ABOUT ME"/>


                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_centerHorizontal="true"
                        android:id="@+id/aboutme_ctxv"
                        android:textColor="@color/grey_dark_text"
                        android:text=""/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

