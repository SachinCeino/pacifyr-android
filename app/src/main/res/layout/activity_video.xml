<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/parent_call"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    >


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:visibility="gone"
        android:orientation="vertical" >

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/switch_camera_action_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:fabSize="mini"
            android:layout_marginBottom="@dimen/fab_margin"
            android:src="@drawable/ic_switch_camera_white_24dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/local_video_action_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/fab_margin"
            android:layout_gravity="center"
            app:fabSize="mini"
            android:src="@drawable/ic_videocam_white_24dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/mute_action_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabSize="mini"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic_white_24dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/connect_action_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fab_margin"
            app:fabSize="normal"
            android:src="@drawable/ic_video_call_white_24dp" />

    </LinearLayout>


    <RelativeLayout
        style="@style/MatchParent"
        android:id="@+id/fragment_container"
        android:background="@color/background_fragment_conversation">


        <!--     android:layout_above="@+id/grid_opponents"-->


        <com.twilio.video.VideoView
            android:id="@+id/primary_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_gravity="center"/>

        <include
            android:visibility="gone"
            layout="@layout/view_outgoing_screen" />

        <LinearLayout
            android:id="@+id/layout_info_about_audio_call"
            style="@style/MatchWidth"
            android:layout_marginTop="250dp"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="vertical"
            android:paddingLeft="@dimen/also_in_call_text_left_right_padding"
            android:paddingRight="@dimen/also_in_call_text_left_right_padding">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/user_dimv"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/placeholder_image"
                    android:visibility="visible"
                    app:aspect_ratio="1"
                    app:height_percentage="10"
                    app:parameter="aspect_width"
                    app:width_percentage="12" />

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/username_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="10dp"
                    android:layout_toRightOf="@+id/user_dimv"
                    android:padding="5dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp18"
                    android:visibility="visible" />
                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:id="@+id/Button_remind_counselor_audio"
                    android:visibility="gone"
                    android:background="@color/white"
                    android:textSize="@dimen/sp12"
                    android:singleLine="true"
                    android:layout_marginTop="5dp"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:text="Remind Provider"
                    android:textColor="@color/colorPrimary"
                    android:layout_height="wrap_content" />
            </LinearLayout>


            <Chronometer
                android:id="@+id/chronometer_timer_audio_call"
                style="@style/WrapContent"
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size"
                 />
            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:id="@+id/TextView_audio_freeminuts_remine"
                android:textSize="@dimen/sp14"
                android:singleLine="true"
                android:layout_marginTop="5dp"
                android:layout_centerVertical="true"
                android:text=""
                android:textColor="@color/colorPrimary"
                android:layout_height="wrap_content" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:id="@+id/info_overlay_llay"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="5dp"
            android:layout_height="wrap_content">

            <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="wrap_content"
                android:padding="8dp"
                android:id="@+id/user_rlay"
                android:layout_alignParentLeft="true"
                android:layout_height="wrap_content">

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:id="@+id/TextView_call_type"
                    android:visibility="visible"
                    android:textSize="@dimen/sp16"
                    android:singleLine="true"
                    android:textStyle="bold"
                    android:text="@string/pacifyr_video"
                    android:textColor="@color/grey_fit"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/connectionStatusLocal"
                    style="@style/MatchWidth"
                    android:layout_below="@+id/TextView_call_type"
                    android:layout_marginTop="10dp"

                    android:maxLines="1"
                    android:text="Ringing..."
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/blue_button_primary"
                    android:textStyle="normal" />



                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:background="@color/transparent"
                    android:id="@+id/emotion_rlay"
                    android:layout_marginTop="10dp"
                    android:visibility="invisible"
                    android:layout_below="@+id/connectionStatusLocal"
                    android:layout_height="wrap_content">

                    <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                        android:id="@+id/emotion_dimv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:src="@drawable/placeholder_user"
                        android:visibility="visible"
                        app:aspect_ratio="1"
                        app:height_percentage="10"
                        app:parameter="aspect_width"
                        app:width_percentage="15" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/l1"
                        android:layout_marginLeft="4dp"
                        android:layout_toRightOf="@+id/emotion_dimv"
                        android:layout_height="wrap_content">

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:id="@+id/emotion_ctxv"
                            android:visibility="visible"
                            android:textSize="@dimen/sp16"
                            android:singleLine="true"
                            android:textStyle="bold"
                            android:text=""
                            android:textColor="@color/colorPrimary"
                            android:layout_height="wrap_content" />

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:id="@+id/reason_ctxv"
                            android:visibility="visible"
                            android:textSize="@dimen/sp16"
                            android:singleLine="true"
                            android:textStyle="bold"
                            android:text=""
                            android:textColor="@color/colorPrimary"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_remaining_minutes"
                        style="@style/WrapContent"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="5dp"
                        android:layout_below="@+id/l1"
                        android:visibility="gone"
                        android:textColor="@color/blue_button_primary"
                        android:textSize="@dimen/also_on_call_text_size" />
                </RelativeLayout>
                <Chronometer
                    android:id="@+id/chronometer_timer_video_call"
                    style="@style/WrapContent"
                    android:layout_width="wrap_content"
                    android:layout_gravity="left"
                    android:layout_margin="10dp"
                    android:layout_below="@+id/emotion_rlay"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size"
                    android:visibility="invisible" />
                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:id="@+id/TextView_vidio_freeminuts_remine"
                    android:visibility="gone"
                    android:layout_below="@+id/chronometer_timer_video_call"
                    android:textSize="@dimen/sp14"
                    android:singleLine="true"
                    android:layout_marginTop="5dp"
                    android:layout_centerVertical="true"
                    android:text=""
                    android:textColor="@color/colorPrimary"
                    android:layout_height="wrap_content" />
                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:id="@+id/Button_remind_counselor_vidio"
                    android:visibility="gone"
                    android:layout_below="@+id/TextView_vidio_freeminuts_remine"
                    android:background="@color/white"
                    android:textSize="@dimen/sp12"
                    android:singleLine="true"
                    android:layout_marginTop="5dp"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:text="Remind Provider"
                    android:textColor="@color/colorPrimary"
                    android:layout_height="wrap_content" />

            </RelativeLayout>


        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:id="@+id/call_overlay_frame"
            android:padding="10dp"
            android:layout_margin="8dp"
            >

            <ImageView
                android:id="@+id/toggle_Max_Min"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:src="@drawable/maximize_"></ImageView>

            <LinearLayout
                android:id="@+id/call_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@+id/toggle_Max_Min"
                android:layout_marginTop="50dp"
                android:background="@drawable/call_overlay_background"
                android:orientation="horizontal"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/ImageView_emotion"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/confused" />
                </LinearLayout>

                <!--
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:id="@+id/ImageView_note"
                                android:padding="5dp">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:src="@drawable/overlay_note" />
                            </LinearLayout>
                -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/more_rlay"
                    android:padding="5dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/overlay_more" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/certificate_View"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/ImageView_kyc"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/overlay_kyc" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/LinearLayout_chat"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/ImageView_chat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/overlay_chat" />
                    <TextView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:id="@+id/messageCount"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/rounded_textview"
                        android:layout_alignParentTop="true"
                        android:layout_marginLeft="25dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:text=""
                        android:textColor="@color/white"
                        ></TextView>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/LinearLayout_prescription"
                    android:padding="5dp">

                    <ImageView
                        android:id="@+id/ImageView_prescription"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/overlay_prescription" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>


        <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/grid_opponents_rlay"
            android:visibility="gone"
            android:layout_above="@+id/element_set_video_buttons"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            style="@style/WrapContent"
            android:background="@color/background_fragment_conversation">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_opponents"
                style="@style/WrapContent"
                android:layout_height="0dp"

                android:layout_marginBottom="@dimen/margin_common"
                android:horizontalSpacing="@dimen/margin_small"
                android:numColumns="3"

                android:verticalSpacing="@dimen/margin_small"
                >
                <!--  android:visibility="gone"-->
            </androidx.recyclerview.widget.RecyclerView>
            <!--    android:layout_above="@+id/element_set_video_buttons"-->
        </RelativeLayout>

        <include
            android:id="@+id/element_set_video_buttons"
            layout="@layout/view_action_buttons_conversation_fragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/billing_status"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin_common" />

        <com.pacifyr.client.customview.MainTextView
            android:id="@+id/billing_status"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="13dp"
            android:background="@drawable/white_border_transparent_black"
            android:enabled="false"
            android:padding="10dp"
            android:text="@string/start_session"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="invisible" />
        <!--  <View
              android:id="@+id/empty_stub"
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:layout_alignParentBottom="true" />-->
    </RelativeLayout>

    <com.twilio.video.VideoView
        android:id="@+id/thumbnail_video_view"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_alignParentRight="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="-1dp"
        app:tviMirror="true"
        app:tviOverlaySurface="true" />


</RelativeLayout>
