<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp">

    <TableLayout
        android:id="@+id/layout_bill_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableRow android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:fontFamily="@string/CenturyGothic"
                android:text="Provider" />

            <TextView
                android:id="@+id/text_provider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/CenturyGothic"
                android:text=""
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:fontFamily="@string/CenturyGothic"
                android:text="Date" />

            <TextView
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/CenturyGothic"
                android:text=""
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:fontFamily="@string/CenturyGothic"
                android:text="Session Start Time" />date

            <TextView
                android:id="@+id/text_start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/CenturyGothic"
                android:text=""
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:fontFamily="@string/CenturyGothic"
                android:text="Duration" />

            <TextView
                android:id="@+id/text_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/CenturyGothic"
                android:text=""
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="10"
                android:fontFamily="@string/CenturyGothic"
                android:text="Amount Charged" />

            <TextView
                android:id="@+id/text_amount_charged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/CenturyGothic"
                android:text=""
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>

    <View
        android:id="@+id/view_separator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/layout_bill_table"
        android:layout_marginTop="30dp"
        android:background="@color/bg_gray" />

    <Button
        android:id="@+id/button_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_separator"
        android:layout_centerHorizontal="true"
        android:background="@drawable/button_white"
        android:text="OK"
        android:textColor="@color/om_blue" />
</RelativeLayout>