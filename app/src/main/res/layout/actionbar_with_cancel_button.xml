<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/action_bar_top_llay"
    android:layout_height="match_parent"
    android:background="@drawable/gray_actionbar_background"
    android:orientation="vertical"
    >


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/bottom_panel"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/left_llay"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:id="@+id/back_imv"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cancel2"
                android:visibility="visible"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_alignParentStart="true"
                app:tint="@color/_color_back_arrow_tint" />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/back_imv"
                android:id="@+id/left_txv"
                android:paddingStart="2dp"
                android:textSize="@dimen/sp15"
                android:visibility="gone"
                android:text=""


                android:layout_centerVertical="true"
                android:textColor="@color/_color_action_bar_text_color"
                />
        </LinearLayout>

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/left_llay"
            android:layout_toLeftOf="@+id/right_llay"
            android:maxLines="1"
            android:maxLength="25"
            android:ellipsize="end"
            android:layout_centerInParent="true"
            android:text=""
            android:padding="5dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/actionbar_title_text_size"
            android:id="@+id/title_txv"
            android:textColor="@color/_color_action_bar_text_color"
            />
        <!--  app:font="@string/avenir_roman"-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/right_llay"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingEnd="5dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_toLeftOf="@+id/right_imv"
                android:id="@+id/right_txv"
                android:paddingEnd="2dp"
                android:textSize="@dimen/sp18"
                android:text=""

                android:textColor="@color/_color_action_bar_text_color"
                android:layout_centerVertical="true"
                />
            <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                android:layout_width="wrap_content"
                android:id="@+id/right_imv"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:width_percentage="7"

                android:layout_marginEnd="4dp"

                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"/>
            <!-- <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                 android:layout_width="wrap_content"
                 android:id="@+id/right2_dimv"
                 android:layout_height="wrap_content"
                 android:visibility="gone"
                 app:width_percentage="7"
                 android:src="@drawable/icon_preferences"
                 android:layout_marginEnd="5dp"

                 android:layout_centerVertical="true"
                 android:layout_centerHorizontal="true"
                 android:layout_alignParentEnd="true" />-->

        </LinearLayout>
    </RelativeLayout>
</LinearLayout>