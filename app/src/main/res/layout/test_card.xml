<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/white_round_square"
    android:layout_height="wrap_content">


    <android.support.v7.widget.CardView
        android:id="@+id/card_pacifyr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        card_view:cardCornerRadius="0dp"
        card_view:contentPadding="0dp"
        android:foregroundGravity="center"
        card_view:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:id="@+id/img_prof"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_user"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/indicator_dimv"
                        android:src="@drawable/offline"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/indicator_ctxv"
                        android:textStyle="bold"
                        android:textSize="6sp"
                        android:layout_marginLeft="5dp"
                        android:textColor="@color/grey_dark"
                        android:text="@string/offline"/>

                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:layout_marginLeft="5dp"
                android:id="@+id/rlay_first">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/linear_text"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_name"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/blue_text_dark"
                        android:text=""/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_dark"
                        android:id="@+id/specialities_ctxv"
                        android:maxLines="3"
                        android:padding="3dp"
                        android:textSize="9sp"
                        android:text=""/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:gravity="center"
                        android:layout_marginTop="3dp"
                        android:orientation="horizontal">

                        <android.support.v7.widget.AppCompatRatingBar
                            android:id="@+id/myRatingBar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:progressTint="@color/blue_text_dark"
                            android:isIndicator="true"/>

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="88 Reviews"
                            android:id="@+id/item_review_tv"
                            android:layout_marginLeft="5dp"
                            android:textColor="@color/blue_text_dark"
                            android:textSize="8sp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <!--<com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  "
                            android:gravity="right"
                            android:id="@+id/doller_sign_ctxv"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>-->

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:id="@+id/price_dollar"
                            android:textColor="@color/colorPrimary"
                            android:textAlignment="center"
                            android:textStyle="bold"
                            android:textSize="10sp"/>

                        <!--<com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  per hour"
                            android:gravity="right"
                            android:id="@+id/perhour_ctxv"
                            android:textColor="@color/white"
                            android:textSize="13sp"/>-->

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/chat_llay"
                        android:background="@drawable/grey_border_white_solid_rectangle_sharp"
                        android:padding="5dp">

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:id="@+id/chat_price_ctxv"
                            android:textColor="@color/grey_dark"
                            android:textAlignment="center"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </android.support.v7.widget.CardView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:layout_below="@+id/card_pacifyr">

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textSize="15sp"
            android:padding="2dp"
            android:id="@+id/description_ctxv"
            android:textColor="@color/grey_dark"/>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Connect_to_Providers"
            android:padding="7dp"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/description_ctxv"
            android:id="@+id/connect_pacifyr_ctxv"
            android:layout_centerInParent="true"
            android:textSize="13sp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/blue_round_square"
            android:textColor="@color/white"/>

    </RelativeLayout>



</RelativeLayout>
