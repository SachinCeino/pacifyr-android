<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:card_view="http://schemas.android.com/apk/res-auto">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:padding="20dp"
        android:background="@color/profile_background"
        android:orientation="vertical"
        android:id="@+id/profile_llay">


        <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:id="@+id/profile_name_ctxv"
            android:text="" />


        <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:id="@+id/pacifyr_role_ctxv"
            android:text="Pacifyr"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/profile_rating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:progressTint="@color/Color_Gold"
                android:rating="0"
                android:isIndicator="true"/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/review_ctxv"
                android:text=""/>

        </LinearLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:id="@+id/profile_cimv"
            android:layout_marginTop="10dp"
            android:src="@drawable/placeholder_user"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/online_offline_imv"
                android:src="@drawable/offline"/>

            <com.pacifyr.omhealthcare.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:layout_marginLeft="5dp"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:id="@+id/isonline_ctxv"
                android:text="" />

        </LinearLayout>

        <com.pacifyr.omhealthcare.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:id="@+id/price_ctxv"
            android:text="" />



    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/profile_llay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_light"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/mail_card"
                android:visibility="visible"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:id="@+id/mail_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/line1"
                        android:layout_toRightOf="@+id/avatar_dimv"
                        android:background="@color/white"
                        android:orientation="horizontal">
                        <com.ceino.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:height_percentage="8"
                            app:width_percentage="8"
                            app:parameter="fixed_ratio"
                            android:layout_marginRight="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/parent_mail_black"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:id="@+id/mail_dtxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp16"
                            app:percentage_height="8" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pnumber_llay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/mail_llay"
                        android:layout_marginTop="10dp"
                        android:layout_toRightOf="@+id/avatar_dimv"
                        android:background="@color/white"
                        android:orientation="horizontal">
                        <com.ceino.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:height_percentage="8"
                            app:width_percentage="8"
                            app:parameter="fixed_ratio"
                            android:layout_marginRight="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_call_grey"/>

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:id="@+id/pnumber_dtxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:gravity="center_vertical"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="@dimen/sp16"
                            app:percentage_height="8" />

                    </LinearLayout>


                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:id="@+id/aboutme_card"
                android:visibility="visible"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="SNAP SHOT"/>


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_centerHorizontal="true"
                        android:id="@+id/aboutme_ctxv"
                        android:textColor="@color/education_desc"
                        android:text=""/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                android:id="@+id/snapshot_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="SNAP SHOT"/>


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:id="@+id/snapshot_ctxv"
                        android:textColor="@color/education_desc"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:id="@+id/blog_card"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="BLOG OR WEBSITE"/>


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_centerHorizontal="true"
                        android:id="@+id/website_ctxv"
                        android:textColor="@color/education_desc"
                        android:text=""/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:id="@+id/speciality_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="AREAS OF SPECIALITY"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/special_rcv"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/special_list_ctxv"
                        android:textColor="@color/education_desc"
                        android:textSize="@dimen/sp12" />

                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:id="@+id/education_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="EDUCATION"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/education_rcv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/certification_card"
                android:layout_margin="20dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/education_title"
                        android:text="CERTIFICATIONS"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/certification_rcv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>


                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
