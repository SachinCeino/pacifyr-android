<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/gray_actionbar_background"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:id="@+id/left_llay"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:paddingLeft="10dp"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content">
            <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                android:layout_width="wrap_content"
                android:id="@+id/back_imv"
                android:layout_height="wrap_content"
                android:src="@drawable/backarrow"
                app:width_percentage="8"
                app:parameter="aspect_width"
                android:padding="3dp"
                android:tint="@color/_color_back_arrow_tint"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:layout_alignParentStart="true" />
        </LinearLayout>

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxLength="25"
            android:ellipsize="end"
            android:layout_centerInParent="true"
            android:text=""
            android:padding="5dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/sp20_title"
            android:id="@+id/title_txv"
            android:textColor="@color/_color_action_bar_text_color"
            />


    </RelativeLayout>

</LinearLayout>