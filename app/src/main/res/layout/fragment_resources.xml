<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical">

  <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="50dp"
              android:id="@+id/searchLayout"
              android:orientation="horizontal"
              android:layout_margin="15dp"
              android:background="@drawable/resource_search_background"
              >
              <SearchView
                  android:id="@+id/SearchView_Resource"
                  android:layout_width="match_parent"
                  android:layout_height="51dp"
                  android:inputType="textCapSentences"
                  android:background="@android:color/transparent"
                  android:iconifiedByDefault="true"
                  android:imeOptions="actionSearch"
                  android:focusable="false"
                  android:queryHint="Article, video, presentation"
                  />
          </LinearLayout>
          <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="230dp"
              android:layout_below="@+id/searchLayout"
              android:id="@+id/cardViewBanner"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_margin="15dp"
              app:cardCornerRadius="6dp"
              >
              <ImageView
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:id="@+id/ImageViewImage"
                  android:adjustViewBounds="true"
                  android:scaleType="centerCrop"
                  android:src="@drawable/resourcebanner">

              </ImageView>
              <RelativeLayout
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:background="@color/black"
                  android:alpha="0.1">

              </RelativeLayout>
              <RelativeLayout
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:layout_marginTop="5dp"
                  android:layout_marginLeft="10dp"
                  android:layout_marginRight="10dp"
                  >
                  <com.pacifyr.client.customview.MainTextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentLeft="true"
                      android:layout_alignParentTop="true"
                      android:text="Daily Highlight"
                      android:textAllCaps="true"
                      android:textColor="@color/white"
                      android:textSize="@dimen/sp13"
                      android:id="@+id/toptitle"
                      >

                  </com.pacifyr.client.customview.MainTextView>
                  <com.pacifyr.client.customview.MainTextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentLeft="true"
                      android:layout_below="@+id/toptitle"
                      android:text="5 min read"
                      android:textColor="@color/white"
                      android:textSize="@dimen/sp11"
                      android:drawablePadding="3dp"
                      android:drawableLeft="@drawable/article"
                      android:drawableStart="@drawable/article">

                  </com.pacifyr.client.customview.MainTextView>

                  <com.pacifyr.client.customview.MainTextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentLeft="true"
                      android:text="Article by Anthony W."
                      android:id="@+id/TextViewAuther"
                      android:textColor="@color/white"
                      android:layout_above="@id/TextViewTitle"
                      android:textSize="@dimen/sp11"
                      >

                  </com.pacifyr.client.customview.MainTextView>
                  <com.pacifyr.client.customview.MainTextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_alignParentLeft="true"
                      android:layout_alignParentBottom="true"
                      android:text="On Slowing Down Time, Procrastination, and Mindfulness"
                      android:id="@+id/TextViewTitle"
                      android:textColor="@color/white"
                      android:textStyle="bold"
                      android:textSize="@dimen/sp14"
                      android:layout_marginBottom="5dp"
                      >

                  </com.pacifyr.client.customview.MainTextView>

              </RelativeLayout>

          </androidx.cardview.widget.CardView>

          <androidx.recyclerview.widget.RecyclerView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@+id/cardViewBanner"
              android:nestedScrollingEnabled="false"
              android:layout_marginTop="10dp"
              android:id="@+id/resources_list_rcv"></androidx.recyclerview.widget.RecyclerView>

          <com.pacifyr.client.customview.MainTextView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_below="@+id/cardViewBanner"
              android:text="No result available !"
              android:gravity="center"
              android:id="@+id/emptyLayout"
              android:visibility="gone"
              >

          </com.pacifyr.client.customview.MainTextView>
      </RelativeLayout>

  </androidx.core.widget.NestedScrollView>

</RelativeLayout>
