<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="left"
    android:padding="10dp"
    android:orientation="vertical">



    <RatingBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rating="2"
        android:theme="@style/RatingBar"
        android:isIndicator="true"
        android:id="@+id/raing_bar"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:gravity="center"
        android:padding="2dp"
        android:id="@+id/date_llay">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:id="@+id/type_ico_imv"
            android:src="@drawable/ic_video_cam_blue"/>

        <com.ceino.utilitylibrary.CustomFontTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:textSize="21sp"
            android:id="@+id/date_ctxv"
            android:textColor="@color/black"
            android:text="01-05-2018"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/grey_hex_e6"/>


</LinearLayout>