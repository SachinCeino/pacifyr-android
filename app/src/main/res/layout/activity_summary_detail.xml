<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_rlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="center"
        android:background="?attr/colorPrimary"
        android:layout_alignParentTop="true"
        android:id="@+id/action_bar"
        android:orientation="horizontal"
        android:theme="@style/AppTheme.PopupOverlay">
        <include layout="@layout/actionbar_three_text_image"/>

    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_below="@+id/action_bar"
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp">

        <RelativeLayout
            android:orientation="vertical" android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="match_parent">

            <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:fillViewport="true"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="0dp"
                        android:background="@color/transparent">
                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        xmlns:tools="http://schemas.android.com/tools"
                        android:id="@+id/activity_last_session"
                        android:layout_width="match_parent"
                        android:background="@color/white"
                        android:layout_height="match_parent"
                        android:paddingRight="20dp"
                        android:paddingLeft="20dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="50dp"
                        android:orientation="vertical"
                       >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_white"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <de.hdodenhof.circleimageview.CircleImageView
                                    android:layout_width="70dp"
                                    android:layout_height="70dp"
                                    android:id="@+id/last_session_cimv"
                                    android:src="@drawable/placeholder_user"/>

                                <com.pacifyr.client.customview.MainTextView
                                    android:layout_width="80dp"
                                    android:layout_height="30dp"
                                    android:layout_marginTop="5dp"
                                    android:gravity="center"
                                    android:text="Call Back"
                                    android:id="@+id/callback_ctxv"
                                    android:textColor="@color/colorPrimary"
                                    android:background="@drawable/button_border"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="left"
                                    android:orientation="horizontal"
                                    android:paddingLeft="10dp">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text=""
                                        android:id="@+id/pacifyr_name_ctxv"
                                        android:textColor="@color/black"
                                        android:textSize="18sp"/>

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text=""
                                        android:layout_below="@+id/pacifyr_name_ctxv"
                                        android:id="@+id/pacifyr_rate_ctxv"
                                        android:textColor="@color/md_grey_user"
                                        android:textSize="13sp"/>


                                </RelativeLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingLeft="10dp">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text="CALL :"
                                        android:textColor="@color/grey_hex_b3"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>

                                    <ImageView
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:layout_marginLeft="5dp"
                                        android:src="@drawable/icon_audio"/>

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:text=" 00 : 00 : 00"
                                        android:layout_marginLeft="5dp"
                                        android:id="@+id/duration_ctxv"
                                        android:textColor="@color/md_grey_user"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:id="@+id/customer_fees_llay"
                                    android:visibility="gone"
                                    android:orientation="horizontal"
                                    android:paddingLeft="10dp">

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentLeft="true"
                                        android:text="TOTAL :"
                                        android:textColor="@color/grey_hex_b3"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>

                                    <com.pacifyr.client.customview.MainTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:text="  "
                                        android:id="@+id/session_cost_ctxv"
                                        android:textColor="@color/blue_rate"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/pacifyr_earings_llay"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical"
                                    android:paddingLeft="10dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="0dp"
                                        android:orientation="horizontal"
                                        >

                                        <com.pacifyr.client.customview.MainTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:text="Earnings :"
                                            android:textColor="@color/grey_hex_b3"
                                            android:textSize="13sp"
                                            android:textStyle="bold"/>

                                        <com.pacifyr.client.customview.MainTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentRight="true"
                                            android:text="  "
                                            android:id="@+id/earingst_ctxv"
                                            android:textColor="@color/md_grey_user"
                                            android:textSize="13sp"
                                            android:textStyle="bold"/>

                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:orientation="horizontal"
                                        >

                                        <com.pacifyr.client.customview.MainTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:text="Company Fees :"
                                            android:textColor="@color/grey_hex_b3"
                                            android:textSize="13sp"
                                            android:textStyle="bold"/>

                                        <com.pacifyr.client.customview.MainTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentRight="true"
                                            android:text="  "
                                            android:id="@+id/comapnyfees_ctxv"
                                            android:textColor="@color/md_grey_user"
                                            android:textSize="13sp"
                                            android:textStyle="bold"/>

                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>

                            <!-- circleview:suffixValue="EUR"-->

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#DFDFDF"/>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            >

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/how_eff_ctxv"
                                android:layout_centerHorizontal="true"
                                android:text="How effective was the call in solving your issues"
                                android:textColor="@color/md_grey_user"
                                android:textSize="14sp"/>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/how_eff_ctxv"
                                android:id="@+id/mmmmm"
                                android:gravity="center"

                                android:orientation="horizontal">


                                <app.minimize.com.seek_bar_compat.SeekBarCompat
                                    android:id="@+id/effective_seekbar"
                                    android:layout_width="200dp"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    app:progressColor="@color/colorPrimary"
                                    app:progressBackgroundColor="#000"
                                    app:thumbColor="@color/grey_fit"
                                    app:thumbAlpha="1.0"/>
                                <!--         android:maxHeight="300sp"-->
                                <com.eralp.circleprogressview.CircleProgressView
                                    android:id="@+id/circle_progress_view"
                                    android:layout_toRightOf="@+id/effective_seekbar"
                                    android:layout_width="75dp"
                                    android:layout_height="75dp"
                                    android:layout_gravity="center"
                                    app:cpv_circle_color="@color/blue_pacifyr"
                                    app:cpv_circle_width="3dp"
                                    android:layout_marginLeft="20dp"
                                    app:cpv_background_circle_width="1dp"
                                    app:cpv_background_circle_color="#5b253048"
                                    app:cpv_text_suffix="%"
                                    app:cpv_text_size="18"
                                    app:cpv_text_color="@color/blue_pacifyr"/>

                            </RelativeLayout>


                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:id="@+id/rating_llay"
                            android:visibility="visible"
                            android:layout_marginTop="20dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/rating_ctxv"
                                android:layout_centerHorizontal="true"
                                android:text="@string/how_you_rate"
                                android:textColor="@color/md_grey_user"
                                android:textSize="14sp"/>


                            <com.willy.ratingbar.ScaleRatingBar
                                android:id="@+id/rating_bar"
                                android:gravity="center"
                                android:layout_marginLeft="10dp"
                                android:layout_width="match_parent"
                                android:layout_marginTop="8dp"
                                android:layout_below="@+id/rating_ctxv"
                                android:layout_height="wrap_content"
                                app:srb_numStars="5"
                                app:srb_starPadding="10dp"
                                app:srb_clickable="true">
                            </com.willy.ratingbar.ScaleRatingBar>


                        </RelativeLayout>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/before_feel_llay"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/before_feel_ctxv"
                                android:layout_centerHorizontal="true"
                                android:text="How were you feeling before the call?"
                                android:textColor="@color/md_grey_user"
                                android:textSize="14sp"/>

                            <ImageView
                                android:id="@+id/before_feel_dimv"
                                android:layout_width="40dp"
                                android:layout_marginTop="3dp"
                                android:layout_below="@+id/before_feel_ctxv"
                                android:layout_height="40dp"
                                android:layout_marginLeft="20dp" />

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/before_emotion_ctxv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/before_feel_dimv"
                                android:text="emotion"
                                android:layout_marginLeft="16dp"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp12"/>

                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/after_feel_llay"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/after_feel_ctxv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="How were you feeling after the call ?"
                                android:textColor="@color/md_grey_user"

                                android:textSize="14sp"

                                />

                            <ImageView
                                android:id="@+id/after_feel_dimv"
                                android:layout_width="40dp"
                                android:layout_marginTop="3dp"
                                android:layout_below="@+id/after_feel_ctxv"
                                android:layout_height="40dp"
                                android:layout_marginLeft="20dp" />

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/after_emotion_ctxv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/after_feel_dimv"
                                android:text="emotion"

                                android:layout_marginLeft="16dp"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp12" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:descendantFocusability="blocksDescendants"
                            android:id="@+id/after_feel_selection_llay"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/after_feel_selection_ctxv"
                                android:text="How are you feeling after the call"
                                android:textColor="@color/md_grey_user"
                                android:textSize="14sp"/>

                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_width="match_parent"
                                android:layout_marginTop="3dp"
                                android:nestedScrollingEnabled="false"
                                android:layout_below="@+id/after_feel_selection_ctxv"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:id="@+id/begning_rcv"/>

                        </RelativeLayout>




                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            android:layout_marginTop="10dp"
                            android:descendantFocusability="blocksDescendants"
                            android:orientation="vertical">

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:id="@+id/experica_ctxv"
                                android:layout_centerHorizontal="true"
                                android:text="How was your audio or video call experience ?"
                                android:textColor="@color/md_grey_user"
                                android:textSize="14sp"/>

                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_width="match_parent"
                                android:layout_marginTop="5dp"
                                android:nestedScrollingEnabled="false"
                                android:layout_below="@+id/experica_ctxv"
                                android:layout_height="wrap_content"
                                android:id="@+id/comments_rcv"/>


                            <com.pacifyrapp.utilitylibrary.CustomEditText
                                android:id="@+id/comments_cedt"
                                android:layout_marginTop="10dp"
                                android:layout_below="@+id/comments_rcv"
                                android:layout_width="match_parent"
                                android:inputType="textCapSentences|textMultiLine"
                                android:textSize="@dimen/sp17"
                                android:hint="@string/comments"
                                android:backgroundTint="@android:color/transparent"
                                android:textColorHint="@color/hint_dark"
                                android:layout_height="wrap_content" />


                        </RelativeLayout>


                    </LinearLayout>

                        <RelativeLayout
                            android:id="@+id/click_rlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/transparent"
                            android:onClick="doNothing"></RelativeLayout>
                    </FrameLayout>
                </androidx.core.widget.NestedScrollView>


            </FrameLayout>
        </RelativeLayout>
    </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
