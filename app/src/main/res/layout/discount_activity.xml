<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/logo_om"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:src="@drawable/powered_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/logo_om"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:padding="16dp">

        <com.pacifyr.client.customview.MainTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/have_discount_code"
            android:textColor="@color/grey_dark"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edit_discount_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Enter Here" />

        <RelativeLayout
            android:id="@+id/button_validate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:background="@drawable/blue_round_square"
            android:padding="10dp">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:text="@string/validate"
                android:textColor="@color/white"
                android:textSize="20sp" />


        </RelativeLayout>

        <com.pacifyr.client.customview.MainTextView
            android:id="@+id/text_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:text="@string/skip_this_step"
            android:textColor="@color/blue_button_primary"
            android:textSize="20sp" />


    </LinearLayout>

</RelativeLayout>