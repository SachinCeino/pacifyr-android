<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

   <androidx.core.widget.NestedScrollView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintTop_toTopOf="parent" >
       <androidx.constraintlayout.widget.ConstraintLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <ImageView
               android:id="@+id/imageView2"
               android:layout_width="match_parent"
               android:layout_height="200dp"
               android:scaleType="centerCrop"
               android:src="@drawable/arcimage"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toTopOf="parent" />

           <LinearLayout
               android:id="@+id/LinearLayout_Active_Session"
               android:layout_width="match_parent"
               android:layout_height="80dp"
               android:background="@color/white"
               android:gravity="center"
               android:visibility="gone"
               android:orientation="horizontal"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toTopOf="parent">

               <com.pacifyr.client.customview.MainTextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="center_vertical"
                   android:text="@string/active_session"
                   android:textColor="@color/black"
                   android:textSize="19sp"
                   android:textStyle="bold">

               </com.pacifyr.client.customview.MainTextView>

               <com.pacifyr.client.customview.MainTextView
                   android:id="@+id/JoinCall"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="center_vertical"
                   android:layout_marginLeft="20dp"
                   android:background="@drawable/blue_border_blue_solid_rectangle_sharp"
                   android:padding="5dp"
                   android:text="@string/Join"
                   android:textColor="@color/white"
                   android:textSize="19sp"
                   android:textStyle="bold">

               </com.pacifyr.client.customview.MainTextView>

               <com.pacifyr.client.customview.MainTextView
                   android:id="@+id/JoinChat"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_gravity="center_vertical"
                   android:layout_marginLeft="20dp"
                   android:background="@drawable/blue_border_blue_solid_rectangle_sharp"
                   android:padding="5dp"
                   android:text="@string/Chat"
                   android:textColor="@color/white"
                   android:textSize="19sp">

               </com.pacifyr.client.customview.MainTextView>
           </LinearLayout>


           <androidx.cardview.widget.CardView
               android:id="@+id/cardView"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginStart="8dp"
               android:layout_marginTop="170dp"
               android:layout_marginEnd="8dp"
               android:background="@color/white"
               app:cardCornerRadius="10dp"
               app:cardElevation="3dp"
               app:cardUseCompatPadding="true"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toTopOf="parent">

               <androidx.constraintlayout.widget.ConstraintLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content">

                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="match_parent"
                       android:orientation="horizontal"
                       android:weightSum="4"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toBottomOf="@+id/textView3">

                       <RelativeLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="10dp">

                           <ImageView
                               android:id="@+id/feel_image_dimv"
                               android:layout_width="50dp"
                               android:layout_height="50dp"
                               android:layout_alignParentTop="true"
                               android:layout_centerInParent="true"
                               android:adjustViewBounds="true"
                               android:backgroundTint="#FFC107"
                               android:foregroundGravity="center"
                               android:scaleType="centerCrop"
                               app:tint="#FFC107" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/feellabel"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/feel_image_dimv"
                               android:layout_gravity="center"
                               android:layout_marginTop="5dp"
                               android:gravity="center"
                               android:text="Last Emotion"
                               android:textColor="@color/grey"
                               android:textSize="12sp" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/feel_title_ctxv"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/feellabel"
                               android:layout_gravity="center"
                               android:layout_marginTop="3dp"
                               android:gravity="center"
                               android:text=""
                               android:textColor="@color/black"
                               android:textSize="12sp"
                               android:textStyle="bold" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/text_feel_error"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_below="@id/feel_image_dimv"
                               android:layout_centerHorizontal="true"
                               android:layout_centerVertical="true"
                               android:gravity="center"
                               android:text="@string/please_select_an_emotion"
                               android:textColor="@color/grey_dark"
                               android:textSize="13sp"
                               android:textStyle="bold"
                               android:visibility="gone" />
                       </RelativeLayout>

                       <RelativeLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="10dp">

                           <de.hdodenhof.circleimageview.CircleImageView
                               android:id="@+id/pacifyr1_dimv"
                               android:layout_width="50dp"
                               android:layout_height="50dp"
                               android:layout_alignParentTop="true"
                               android:layout_centerInParent="true" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/fav_provider"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/pacifyr1_dimv"
                               android:layout_gravity="center"
                               android:layout_marginTop="5dp"
                               android:gravity="center"
                               android:text="Fav.Provider"
                               android:textColor="@color/grey"
                               android:textSize="12sp" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/fav_provider_name"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/fav_provider"
                               android:layout_gravity="center"
                               android:layout_marginTop="3dp"
                               android:gravity="center"
                               android:text=""
                               android:textColor="@color/black"
                               android:textSize="12sp"
                               android:textStyle="bold" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/no_pacifyr_ctxv"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_below="@id/fav_provider_name"
                               android:layout_centerHorizontal="true"
                               android:layout_centerVertical="true"
                               android:gravity="center"
                               android:text="@string/___"
                               android:textColor="@color/grey_dark"
                               android:textSize="13sp"
                               android:textStyle="bold"
                               android:visibility="gone" />
                       </RelativeLayout>


                       <RelativeLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="10dp">

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/sessions_txv"
                               android:layout_width="50dp"
                               android:layout_height="50dp"
                               android:layout_alignParentTop="true"
                               android:layout_centerInParent="true"
                               android:background="@drawable/rounded_textview"
                               android:backgroundTint="@color/colorPrimary"
                               android:gravity="center"
                               android:text="0"
                               android:textColor="@color/white"
                               android:textSize="15sp" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/label_mySession"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/sessions_txv"
                               android:layout_gravity="center"
                               android:layout_marginTop="5dp"
                               android:gravity="center"
                               android:text="My Sessions"
                               android:textColor="@color/grey"
                               android:textSize="12sp" />


                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/sessionCostTotal"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/label_mySession"
                               android:layout_gravity="center"
                               android:layout_marginTop="3dp"
                               android:gravity="center"
                               android:text=""
                               android:textColor="@color/black"
                               android:textSize="12sp"
                               android:textStyle="bold" />

                       </RelativeLayout>


                       <RelativeLayout
                           android:layout_width="0dp"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center"
                           android:layout_weight="1"
                           android:gravity="center"
                           android:padding="10dp">

                           <de.hdodenhof.circleimageview.CircleImageView
                               android:id="@+id/last_session_dimv"
                               android:layout_width="50dp"
                               android:layout_height="50dp"
                               android:layout_alignParentTop="true"
                               android:layout_centerInParent="true" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/last_Session"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/last_session_dimv"
                               android:layout_gravity="center"
                               android:layout_marginTop="5dp"
                               android:gravity="center"
                               android:text="Last Session"
                               android:textColor="@color/grey"
                               android:textSize="12sp" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/days_txv"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_below="@+id/last_Session"
                               android:layout_gravity="center"
                               android:layout_marginTop="3dp"
                               android:gravity="center"
                               android:text="@string/_0_days_ago"
                               android:textColor="@color/black"
                               android:textSize="12sp"
                               android:textStyle="bold" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/no_lastsession_ctxv"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"
                               android:layout_centerInParent="true"
                               android:layout_centerHorizontal="true"
                               android:layout_centerVertical="true"
                               android:gravity="center"
                               android:padding="10dp"
                               android:text="@string/___"
                               android:textColor="@color/black"
                               android:textSize="15sp"
                               android:textStyle="bold"
                               android:visibility="gone" />
                       </RelativeLayout>
                   </LinearLayout>

                   <com.pacifyr.client.customview.MainTextView
                       android:id="@+id/textView3"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_margin="10dp"
                       android:text="@string/status"
                       android:textAllCaps="true"
                       android:textColor="@color/black"
                       android:textSize="14sp"
                       android:textStyle="bold"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent" />
               </androidx.constraintlayout.widget.ConstraintLayout>


           </androidx.cardview.widget.CardView>

           <androidx.cardview.widget.CardView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toBottomOf="@+id/cardView"
               android:padding="10dp"
               app:cardCornerRadius="10dp"
               android:visibility="gone"
               android:id="@+id/CardView_unReadMessageLayout"
               android:layout_marginStart="16dp"
               android:layout_marginTop="8dp"
               android:layout_marginEnd="16dp"
               >
               <androidx.constraintlayout.widget.ConstraintLayout
                   android:layout_width="match_parent"
                   android:layout_height="50dp"
                   android:background="#E65C52"
                   >

                   <ImageView
                       android:id="@+id/ImageView_right_arrow"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="8dp"
                       android:layout_marginBottom="8dp"
                       app:layout_constraintBottom_toBottomOf="parent"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintTop_toTopOf="parent"
                       app:srcCompat="@drawable/unread_right_arrow"
                       app:tint="@color/white" />

                   <ImageView
                       android:id="@+id/ImageView_message_icon"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       app:layout_constraintBottom_toBottomOf="@+id/ImageView_right_arrow"
                       app:layout_constraintEnd_toStartOf="@+id/ImageView_right_arrow"
                       app:layout_constraintTop_toTopOf="@+id/ImageView_right_arrow"
                       app:srcCompat="@drawable/unread_meesg_msg" />

                   <com.pacifyr.client.customview.MainTextView
                       android:id="@+id/unread_chat_ctxv"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginEnd="16dp"
                       android:text="2"
                       android:textColor="@color/white"
                       android:textStyle="bold"
                       android:textSize="16sp"
                       app:layout_constraintBottom_toBottomOf="@+id/ImageView_message_icon"
                       app:layout_constraintEnd_toStartOf="@+id/ImageView_message_icon"
                       app:layout_constraintTop_toTopOf="@+id/ImageView_message_icon" />

                   <androidx.cardview.widget.CardView
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="8dp"
                       android:layout_marginEnd="8dp"
                       app:cardBackgroundColor="@color/white"
                       app:cardCornerRadius="10dp"
                       app:cardUseCompatPadding="true"
                       app:layout_constraintBottom_toBottomOf="parent"
                       app:layout_constraintEnd_toStartOf="@+id/unread_chat_ctxv"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent">

                       <androidx.constraintlayout.widget.ConstraintLayout
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:layout_constraintStart_toStartOf="parent"
                           app:layout_constraintTop_toTopOf="parent">

                           <ImageView
                               android:id="@+id/ImageView_msg_Provider"
                               android:layout_width="30dp"
                               android:layout_height="30dp"
                               android:layout_marginStart="8dp"
                               android:layout_marginTop="8dp"
                               android:layout_marginBottom="8dp"
                               app:layout_constraintBottom_toBottomOf="parent"
                               app:layout_constraintStart_toStartOf="parent"
                               app:layout_constraintTop_toTopOf="parent"
                               app:srcCompat="@drawable/attach_contact" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/TextView_msg_Provider_name"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_marginStart="16dp"
                               android:text="Name: "
                               app:layout_constraintBottom_toBottomOf="@+id/ImageView_msg_Provider"
                               app:layout_constraintStart_toEndOf="@+id/ImageView_msg_Provider"
                               app:layout_constraintTop_toTopOf="@+id/ImageView_msg_Provider"
                               app:layout_constraintVertical_bias="0.545" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/TextView_msg"
                               android:layout_width="wrap_content"
                               android:layout_height="wrap_content"
                               android:layout_marginStart="8dp"
                               android:text="Hi..."
                               app:layout_constraintBottom_toBottomOf="@+id/TextView_msg_Provider_name"
                               app:layout_constraintEnd_toEndOf="parent"
                               app:layout_constraintStart_toEndOf="@+id/TextView_msg_Provider_name"
                               app:layout_constraintTop_toTopOf="@+id/TextView_msg_Provider_name" />
                       </androidx.constraintlayout.widget.ConstraintLayout>
                   </androidx.cardview.widget.CardView>


               </androidx.constraintlayout.widget.ConstraintLayout>
           </androidx.cardview.widget.CardView>

           <androidx.cardview.widget.CardView
               android:layout_width="0dp"
               android:id="@+id/CardView_resource"
               android:layout_height="wrap_content"
               android:layout_marginStart="8dp"
               android:layout_marginTop="8dp"
               android:layout_marginEnd="8dp"
               app:cardCornerRadius="10dp"
               app:cardUseCompatPadding="true"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toBottomOf="@+id/CardView_unReadMessageLayout">
               <androidx.constraintlayout.widget.ConstraintLayout
                   android:layout_width="match_parent"
                   android:layout_height="match_parent">

                   <com.pacifyr.client.customview.MainTextView
                       android:id="@+id/textView7"
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="10dp"
                       android:layout_marginTop="10dp"
                       android:layout_marginBottom="10dp"
                       android:text="@string/resources"
                       android:textColor="@color/black"
                       android:textSize="14sp"
                       android:textStyle="bold"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent" />

                   <ImageView
                       android:id="@+id/imageView7"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="5dp"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintTop_toTopOf="parent"
                       app:srcCompat="@drawable/unread_right_arrow" />

                   <TextView
                       android:id="@+id/TextView_ViewAll"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="View All"
                       android:textColor="@color/colorPrimary"
                       android:textSize="14sp"
                       android:textStyle="bold"
                       app:layout_constraintBottom_toBottomOf="@+id/textView7"
                       app:layout_constraintEnd_toStartOf="@+id/imageView7"
                       app:layout_constraintTop_toTopOf="@+id/textView7" />

                   <androidx.recyclerview.widget.RecyclerView
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="8dp"
                       android:layout_marginEnd="8dp"
                       android:nestedScrollingEnabled="false"
                       android:id="@+id/resources_list_rcv"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="@+id/textView7"
                       app:layout_constraintTop_toBottomOf="@+id/textView7" />
               </androidx.constraintlayout.widget.ConstraintLayout>
           </androidx.cardview.widget.CardView>

           <androidx.cardview.widget.CardView
               android:layout_width="0dp"
               android:id="@+id/CardView_nextAppointment"
               android:layout_height="wrap_content"
               android:layout_marginStart="8dp"
               android:layout_marginTop="8dp"
               android:layout_marginEnd="8dp"
               app:cardCornerRadius="10dp"
               app:cardUseCompatPadding="true"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toBottomOf="@+id/CardView_resource">
               <androidx.constraintlayout.widget.ConstraintLayout
                   android:layout_width="match_parent"
                   android:layout_height="match_parent">

                   <com.pacifyr.client.customview.MainTextView
                       android:id="@+id/mainTextView"
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="10dp"
                       android:layout_marginTop="10dp"
                       android:text="NEXT APPOINTMENT"
                       android:textColor="@color/black"
                       android:textSize="14sp"
                       android:textStyle="bold"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toTopOf="parent" />

                   <ImageView
                       android:id="@+id/imageView_goto_appointment"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="5dp"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintTop_toTopOf="parent"
                       app:srcCompat="@drawable/unread_right_arrow" />

                   <TextView
                       android:id="@+id/TextView_ViewAll_appointment"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="View All"
                       android:textColor="@color/colorPrimary"
                       android:textSize="14sp"
                       android:textStyle="bold"
                       app:layout_constraintBottom_toBottomOf="@+id/imageView_goto_appointment"
                       app:layout_constraintEnd_toStartOf="@+id/imageView_goto_appointment"
                       app:layout_constraintTop_toTopOf="@+id/imageView_goto_appointment" />

                   <androidx.cardview.widget.CardView
                       android:layout_width="0dp"
                       android:layout_height="wrap_content"
                       android:layout_marginStart="8dp"
                       android:layout_marginTop="8dp"
                       android:layout_marginEnd="8dp"
                       android:padding="10dp"
                       app:cardBackgroundColor="@color/bg_gray"
                       app:cardCornerRadius="10dp"
                       app:cardUseCompatPadding="true"
                       app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toBottomOf="@+id/mainTextView">

                       <androidx.constraintlayout.widget.ConstraintLayout
                           android:layout_width="match_parent"
                           android:layout_height="match_parent"
                           app:layout_constraintStart_toStartOf="parent"
                           app:layout_constraintTop_toTopOf="parent"
                           android:paddingBottom="10dp">

                           <de.hdodenhof.circleimageview.CircleImageView
                               android:id="@+id/Img_next_app_provider"
                               android:layout_width="50dp"
                               android:layout_height="50dp"
                               android:layout_marginStart="8dp"
                               android:layout_marginTop="8dp"
                               android:layout_marginBottom="8dp"
                               app:layout_constraintBottom_toBottomOf="parent"
                               app:layout_constraintStart_toStartOf="parent"
                               app:layout_constraintTop_toTopOf="parent"
                               app:srcCompat="@drawable/placeholder_user" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/next_app_provider_name"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_marginStart="16dp"
                               android:layout_marginTop="8dp"
                               android:text="TextView"
                               android:textStyle="bold"
                               android:textSize="16sp"
                               app:layout_constraintEnd_toEndOf="parent"
                               app:layout_constraintStart_toEndOf="@+id/Img_next_app_provider"
                               app:layout_constraintTop_toTopOf="parent" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/next_app_category"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_marginTop="5dp"
                               android:text="TextView"
                               android:textSize="14sp"
                               android:textColor="#6F000000"
                               app:layout_constraintEnd_toEndOf="parent"
                               app:layout_constraintStart_toStartOf="@+id/next_app_provider_name"
                               app:layout_constraintTop_toBottomOf="@+id/next_app_provider_name" />

                           <com.pacifyr.client.customview.MainTextView
                               android:id="@+id/next_app_time"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_marginTop="10dp"
                               android:text="TextView"
                               android:textSize="14sp"
                               android:textColor="#219271"
                               android:textStyle="bold"
                               app:layout_constraintEnd_toEndOf="parent"
                               app:layout_constraintStart_toStartOf="@+id/next_app_category"
                               app:layout_constraintTop_toBottomOf="@+id/next_app_category" />
                       </androidx.constraintlayout.widget.ConstraintLayout>


                   </androidx.cardview.widget.CardView>


               </androidx.constraintlayout.widget.ConstraintLayout>
           </androidx.cardview.widget.CardView>
