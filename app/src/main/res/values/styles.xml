    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/graph_light</item>
        <item name="colorControlActivated">@color/md_yellow_600</item>
    </style>


    <style name="OMEditTheme">
        <!-- Used for the bottom line when not selected / focused -->
        <item name="colorControlNormal">@color/om_blue</item>
        <!-- colorControlActivated & colorControlHighlight use the colorAccent color by default -->
    </style>

    <style name="CustomNoActionBarTheme2.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="CustomNoActionBarTheme2.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

