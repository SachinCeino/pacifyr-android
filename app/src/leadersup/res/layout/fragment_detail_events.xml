<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer">

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <android.support.v7.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="6dp"
                        android:id="@+id/frame1"
                        app:cardBackgroundColor="@color/white">

                        <ImageView
                            android:id="@+id/event_detail_image"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:scaleType="fitXY"
                            android:background="@color/white" />

                    </android.support.v7.widget.CardView>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_below="@+id/frame1"
                        android:layout_marginTop="5dp">

                        <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/txtv_event_title"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="3dp" />

                        <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/txtv_event_time"
                            android:textColor="@color/grey_hex_8b"
                            android:textSize="@dimen/event_sub_title_size_in_detail"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:drawableLeft="@drawable/svg_event_time_date__detail"
                            android:drawablePadding="3dp"
                            android:layout_marginBottom="3dp" />

                        <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/txtv_event_address"
                            android:textColor="@color/grey_hex_8b"
                            android:textSize="@dimen/event_sub_title_size_in_detail"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:drawableLeft="@drawable/svg_event_location_detail"
                            android:drawablePadding="3dp" />

                    </LinearLayout>


                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view_color"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp">

                </View>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="@dimen/title_size_in_detail"
                            android:textStyle="bold"
                            android:text="@string/description"
                            android:textAllCaps="true"
                            android:layout_marginBottom="3dp" />

                        <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/txtv_event_description"
                            android:textColor="@color/grey_hex_8b"
                            android:textSize="@dimen/event_sub_title_size_in_detail"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:layout_marginBottom="3dp" />

                    </LinearLayout>


                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view_color"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp">

                </View>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="@dimen/title_size_in_detail"
                            android:textStyle="bold"
                            android:text="@string/schedule"
                            android:textAllCaps="true"
                            android:layout_marginBottom="3dp" />

                        <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/txtv_event_schedule"
                            android:textColor="@color/grey_hex_8b"
                            android:textSize="@dimen/event_sub_title_size_in_detail"
                            android:layout_gravity="left"
                            android:gravity="left"
                            android:layout_marginBottom="3dp" />

                    </LinearLayout>


                </RelativeLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/view_color"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp">

                </View>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="@dimen/title_size_in_detail"
                            android:textStyle="bold"
                            android:text="@string/attending_employers"
                            android:textAllCaps="true"
                            android:layout_marginBottom="3dp" />

                        <android.support.v7.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/rcv_attending_company"></android.support.v7.widget.RecyclerView>

                    </LinearLayout>


                </RelativeLayout>


            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:id="@+id/footer">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#f4f4f4"
            android:layout_marginTop="5dp">

        </View>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/layout_attending"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:background="@drawable/primary_border_transparent"
                android:padding="15dp">

                <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attending"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/event_sub_title_size_in_detail"
                    android:drawablePadding="5dp"
                    android:textColor="@color/colorPrimary"
                    android:drawableLeft="@drawable/svg_attending"

                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/layout_checkIn"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:background="@drawable/primary_border_transparent"
                android:padding="15dp">

                <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Check in"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textSize="@dimen/event_sub_title_size_in_detail"
                    android:drawablePadding="5dp"
                    android:textColor="@color/colorPrimary"
                    android:drawableLeft="@drawable/svg_checkin"

                    />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>