<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_checkIn"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:weightSum="3"
            android:orientation="horizontal"
            android:layout_gravity="top"
            android:gravity="top"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="6dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center"
                    app:cardElevation="1dp">

                    <ImageView
                        android:id="@+id/img_company_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:layout_gravity="center"
                        android:padding="5dp"
                        android:background="@color/white" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_gravity="left"
                android:gravity="left"
                android:layout_marginLeft="5dp">


                <com.pacifyr.client.events.views.EventTextViewBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtv_company_title"
                    android:textColor="@color/black"
                    android:textSize="@dimen/event_title_size"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />

                <com.pacifyr.client.events.views.EventTextViewMedium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtv_company_mail"
                    android:textColor="@color/grey_hex_8b"
                    android:textSize="@dimen/event_title_size"
                    android:drawableLeft="@drawable/svg_event_message"
                    android:drawablePadding="3dp"
                    android:layout_marginBottom="2dp" />

                <com.pacifyr.client.events.views.EventTextViewMedium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtv_company_phone"
                    android:drawableLeft="@drawable/svg_event_call"
                    android:drawablePadding="3dp"
                    android:textColor="@color/grey_hex_8b"
                    android:textSize="@dimen/event_sub_title_size"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginBottom="2dp" />


            </LinearLayout>

        </LinearLayout>

        <View

            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            android:background="@color/view_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp"
            android:orientation="vertical">

            <com.pacifyr.client.events.views.EventTextViewBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/event_title_size"
                android:textStyle="bold"
                android:layout_marginLeft="10dp"
                android:text="@string/current_opening"
                android:layout_marginBottom="3dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:id="@+id/rcv_attendList"></androidx.recyclerview.widget.RecyclerView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:id="@+id/layout_checkIn"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:background="@drawable/primary_border_transparent"
        android:padding="15dp">

        <com.pacifyr.client.events.views.EventTextViewBold
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Check in"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="@dimen/event_sub_title_size_in_detail"
            android:drawablePadding="5dp"
            android:textColor="@color/colorPrimary"
            android:drawableLeft="@drawable/svg_checkin"

            />
    </LinearLayout>

</RelativeLayout>