        <RelativeLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="5dp"
            android:padding="5dp"
            android:gravity="center"
            android:background="@color/grey_dark"
            android:id="@+id/emotion_rlay"
            android:layout_height="wrap_content">

            <com.ceino.utilitylibrary.DeviceFitImageView
                android:layout_width="wrap_content"
                android:id="@+id/emotion_dimv"
                app:width_percentage="15"
                android:layout_marginLeft="5dp"
                android:visibility="visible"
                app:height_percentage="12"
                android:layout_centerHorizontal="true"
                app:parameter="aspect_width"
                app:aspect_ratio="1"
                android:src="@drawable/placeholder_user"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/emotion_dimv"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:singleLine="true"
                        android:text="Emotion : "
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp16"
                        android:textStyle="bold"
                        android:visibility="visible"
                        app:fontName="@string/avenir_black" />

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:id="@+id/emotion_ctxv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp16"
                        android:textStyle="bold"
                        android:visibility="visible"
                        app:fontName="@string/avenir_black" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:text="Reason : "
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp16"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:fontName="@string/avenir_black" />

                        <com.ceino.utilitylibrary.CustomFontTextView
                            android:id="@+id/reason_ctxv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:lines="2"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/sp16"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:fontName="@string/avenir_black" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </RelativeLayout>

        <Chronometer
            android:id="@+id/chronometer_timer_audio_call"
            style="@style/WrapContent"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_common"
            android:textColor="@color/blue_button_primary"
            android:textSize="@dimen/text_size"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/text_remaining_minutes"
            style="@style/WrapContent"
            android:layout_marginTop="5dp"
            android:textColor="@color/blue_button_primary"
            android:textSize="@dimen/also_on_call_text_size" />

        <TextView
            android:id="@+id/text_also_on_call"
            style="@style/WrapContent"
            android:visibility="invisible"
            android:layout_marginTop="24dp"
            android:text="@string/also_on_call"
            android:textColor="@color/text_color_also_on_call"
            android:textSize="@dimen/also_on_call_text_size" />

        <TextView
            android:id="@+id/text_other_inc_users"
            style="@style/WrapContent"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@color/text_color_other_inc_users"
            android:textSize="@dimen/other_inc_users_text_size"
            tools:text="@string/user_list_on_call" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:id="@+id/info_overlay_llay"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="5dp"
        android:layout_height="wrap_content">
        <RelativeLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"

            android:padding="8dp"
            android:background="@color/grey_dark"
            android:id="@+id/user_rlay"
            android:layout_alignParentLeft="true"
            android:layout_height="wrap_content">
            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="wrap_content"
                android:id="@+id/call_ctxv"
                app:fontName="@string/avenir_black"
                android:visibility="visible"
                android:textSize="@dimen/sp18"
                android:singleLine="true"
                android:textStyle="bold"
                android:text="@string/audio_call"
                android:textColor="@color/grey_fit"
                android:layout_height="wrap_content" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/call_ctxv"
                android:layout_height="wrap_content">
                <!--        <com.ceino.utilitylibrary.DeviceFitImageView
                            android:layout_width="wrap_content"
                            android:id="@+id/user_dimv"
                            app:width_percentage="12"
                android:background="@drawable/shape_circle"
                            android:visibility="visible"
                            app:height_percentage="10"
                            android:layout_centerVertical="true"
                            app:parameter="aspect_width"
                            app:aspect_ratio="1"

                            android:src="@drawable/placeholder_image"
                            android:layout_height="wrap_content" />-->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="45dp"
                        android:id="@+id/user_dimv"
                        app:width_percentage="12"
                        android:visibility="visible"
                        app:height_percentage="10"
                        android:layout_centerVertical="true"
                        app:parameter="aspect_width"
                        app:aspect_ratio="1"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/placeholder_image"
                        android:layout_height="45dp" />

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:id="@+id/username_ctxv"
                        android:layout_toRightOf="@+id/user_dimv"
                        android:visibility="visible"
                        android:textSize="@dimen/sp18"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:padding="5dp"
                        android:text=""
                        android:textColor="@color/blue_button_primary"
                        android:layout_height="wrap_content" />

                <RelativeLayout
                    android:id="@+id/more_rlay"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!--<com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="wrap_content"
                        android:id="@+id/more_dimv"
                        app:width_percentage="8"
                        android:visibility="visible"
                        app:height_percentage="8"
                        app:parameter="fixed_ratio"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_more_menu"
                        android:layout_height="wrap_content" />-->

                    <com.ceino.utilitylibrary.DeviceFitImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:parameter="aspect_width"
                        app:width_percentage="11"
                        android:padding="9dp"
                        android:layout_centerInParent="true"
                        android:tint="@color/colorPrimary"
                        android:background="@drawable/circle_line_border"
                        android:src="@drawable/ic_more_menu"
                        android:id="@+id/more_dimv"/>

                    <com.ceino.utilitylibrary.CustomFontTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:layout_marginTop="15dp"
                        android:layout_below="@+id/more_dimv"
                        android:text="Past sessions"/>

                </RelativeLayout>
            <!--    <com.ceino.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/more_dimv"
                    android:layout_alignParentRight="true"
                    app:width_percentage="15"
                    android:visibility="gone"
                    app:height_percentage="10"
                    android:layout_centerVertical="true"
                    app:parameter="aspect_width"
                    app:aspect_ratio="1"
                    android:src="@drawable/call_mic_off"
                    android:layout_height="wrap_content" />-->

            </RelativeLayout>
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/connectionStatusLocal"
                style="@style/MatchWidth"
                android:layout_marginBottom="@dimen/margin_very_small"
                android:layout_marginTop="10dp"
                android:maxLength="13"
                android:maxLines="1"
                android:text="Ringing..."
                android:layout_marginLeft="4dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/blue_button_primary"
                android:textStyle="normal" />

        </RelativeLayout>
    </LinearLayout>
    <include layout="@layout/view_outgoing_screen" android:visibility="gone"/>

    <include layout="@layout/view_audio_action_buttons_conversation_fragment" />

    <com.ceino.utilitylibrary.CustomFontTextView
        android:id="@+id/billing_status"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="13dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/white_border_transparent_black"
        android:enabled="false"
        android:padding="10dp"
        android:text="@string/start_session"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="invisible" />

</RelativeLayout>