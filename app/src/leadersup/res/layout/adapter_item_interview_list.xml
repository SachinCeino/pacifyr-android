<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/l1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <ImageView
                    android:id="@+id/company_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:background="@color/white" />
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/l1"
            android:layout_marginLeft="5dp">

            <com.pacifyr.omhealthcare.events.views.EventTextViewBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/company_title"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/event_title_size"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"
                android:text="" />


            <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/offer_title"
                android:textColor="@color/grey_hex_8b"
                android:textSize="@dimen/event_sub_title_size"
                android:maxLines="4"
                android:text=""
                android:ellipsize="end"
                android:layout_marginBottom="5dp" />

            <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/offer_date"
                android:textColor="@color/black"
                android:textSize="12dp"
                android:maxLines="3"
                android:text=""
                android:textStyle="bold"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />
        </LinearLayout>


    </RelativeLayout>


    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="2dp"
        android:background="@color/grey" />


</RelativeLayout>
