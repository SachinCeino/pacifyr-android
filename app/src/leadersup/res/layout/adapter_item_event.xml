<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:minHeight="150dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="3"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="6dp"
                android:layout_margin="5dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:id="@+id/event_image"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_gravity="top"
                    android:scaleType="centerCrop"
                    android:background="@color/white" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_gravity="left"
            android:gravity="left"
            android:layout_marginLeft="5dp">

            <com.pacifyr.client.events.views.EventTextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtv_event_date"
                android:textColor="@color/grey_hex_8b"
                android:textSize="@dimen/event_title_size"
                android:layout_marginBottom="2dp" />

            <com.pacifyr.client.events.views.EventTextViewBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtv_event_title"
                android:textColor="@color/black"
                android:textSize="@dimen/event_title_size"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <com.pacifyr.client.events.views.EventTextViewMedium
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/txtv_event_description"
                android:textColor="@color/grey_hex_8b"
                android:textSize="@dimen/event_sub_title_size"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="left"
                android:gravity="left"
                android:layout_marginTop="2dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:padding="2dp"
                    app:srcCompat="@drawable/svg_event_location" />

                <com.pacifyr.client.events.views.EventTextViewMedium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/txtv_event_address"
                    android:textColor="@color/grey_hex_8b"
                    android:textSize="@dimen/event_sub_title_size"
                    android:layout_gravity="left"
                    android:gravity="left"
                    android:maxLines="2"
                    android:layout_marginLeft="2dp"
                    android:ellipsize="end"
                    android:layout_marginBottom="3dp" />
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="2dp"
        android:background="@color/grey" />


</RelativeLayout>
