<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent">
    </include>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.percentlayout.widget.PercentRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">


        <RelativeLayout
            android:id="@+id/logo_rlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:layout_marginTopPercent="5%">

            <ImageView
                android:layout_width="150dp"
                android:src="@drawable/powered_logo"
                android:layout_height="150dp"
                android:visibility="gone"
                android:layout_centerHorizontal="true"
                android:id="@+id/logo_blue"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:id="@+id/profile_cimv"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/logo_blue"
                android:src="@drawable/ic_camera"/>


           <!-- <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_camera"
                android:id="@+id/user_img"
                android:layout_below="@+id/logo_blue"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true" />-->


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/hint_llay"
            android:layout_below="@+id/logo_rlay"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            app:layout_marginTopPercent="10%"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/sp16"
                android:id="@+id/label_name"
                android:layout_marginTop="15dp"
                android:padding="5dp"/>
            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/name_edt"
                android:inputType="textCapSentences|textMultiLine"
                android:theme="@style/OMEditTheme"
                android:gravity="left"
                android:layout_below="@+id/label_name"
                android:minHeight="30dp"
                android:textSize="@dimen/sp14"
                android:padding="10dp"
                android:background="@drawable/black_border_white_back"
                android:textColor="@color/medium_grey_pacifyr"
                />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prompt_email"
                android:textSize="@dimen/sp16"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:id="@+id/label_email"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/name_edt"
                android:padding="5dp"/>

            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:id="@+id/email_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:minHeight="30dp"
                android:gravity="left"
                android:theme="@style/OMEditTheme"
                android:layout_below="@+id/label_email"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/sp14"
                android:padding="10dp"
                android:background="@drawable/black_border_white_back"
                android:textColor="@color/medium_grey_pacifyr"
                android:layout_height="wrap_content"
               />

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/phone"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/sp16"
                android:id="@+id/label_phone"
                android:layout_marginTop="15dp"
                android:layout_below="@+id/email_edt"
                android:padding="5dp"
                />

            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:id="@+id/phone_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:minHeight="30dp"
                android:gravity="left"
                android:theme="@style/OMEditTheme"
                android:visibility="visible"
                android:inputType="phone"
                android:layout_below="@+id/label_phone"
                android:clickable="false"
                android:textSize="@dimen/sp14"
                android:padding="10dp"
                android:background="@drawable/black_border_white_back"
                android:textColor="@color/grey_dark_text"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:id="@+id/phone_llay"
                android:visibility="gone"
                android:layout_below="@+id/phone_edt"
                android:layout_height="wrap_content">

                <!--<com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView"
                    android:layout_alignLeft="@+id/textView"/>


                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/phone_cedit"
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:textSize="@dimen/sp14"
                    android:maxLength="10"
                    android:theme="@style/OMEditTheme"
                    android:background="@null"
                    android:maxLines="1"
                    android:hint="@string/phone"
                    android:textColorHint="@color/phone_grey"
                    android:layout_height="40dp" />

            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@+id/phone_llay"
                android:id="@+id/l1">
                <dev.aige.wheelpicker.widgets.WheelYearPicker
                    android:id="@+id/wheel_date_picker_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:wheel_visible_item_count="3"
                    app:wheel_curved="true"
                    android:visibility="gone" />

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/year_of_birth"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>

                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/year_edt"
                    android:layout_width="match_parent"
                    android:gravity="left"
                    android:textSize="@dimen/sp14"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:theme="@style/OMEditTheme"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_height="wrap_content" />

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zipcode"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>
                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/zipcode_view"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:inputType="phone"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>


                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_region"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/CustomEditText_region"
                    android:inputType="textCapSentences|textMultiLine"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:hint="select option"
                    android:focusable="false"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gender"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/CustomEditText_gender"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:hint="select option"
                    android:focusable="false"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>


                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/race_or_ethinicity"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginTop="15dp"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/CustomEditText_race"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:hint="select option"
                    android:focusable="false"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/education_status"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/CustomEditText_education"
                    android:hint="select option"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:focusable="false"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>


                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Would_you_like_reffered_services"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:layout_marginTop="15dp"
                    android:padding="5dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/listView_like_services"
                    android:layout_marginBottom="5dp"/>


                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_organization"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/CustomEditText_organization"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:hint="select option"
                    android:padding="10dp"
                    android:focusable="false"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="5dp"/>


                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/type_school_name"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>
                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/public_school_name"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:padding="10dp"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/organization_not_listed"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>
                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:id="@+id/other_school_name"
                    android:inputType="textCapSentences"
                    android:textSize="@dimen/sp14"
                    android:padding="10dp"
                    android:theme="@style/OMEditTheme"
                    android:gravity="left"
                    android:background="@drawable/black_border_white_back"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:layout_marginBottom="15dp"/>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/visa_content"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>
               <RadioGroup
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:id="@+id/radio_group"
                   android:orientation="vertical">
                   <RadioButton
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:id="@+id/radioButton_yes"
                       android:text="Yes"
                       android:textSize="@dimen/sp14"
                       android:textColor="@color/black"/>
                   <RadioButton
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:id="@+id/radioButton_no"
                       android:text="No"
                       android:textSize="@dimen/sp14"
                       android:textColor="@color/black"/>
               </RadioGroup>

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/receiving_sms_text"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="@dimen/sp16"
                    android:padding="5dp"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/radioButton_receive_sms"
                    android:text="I agree"
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"/>

            </LinearLayout>
          <!--  <CheckBox
                android:id="@+id/checkBox"
                android:layout_width="wrap_content"
                android:layout_below="@+id/l1"
                android:layout_marginTop="10dp"
                android:textSize="@dimen/sp10"
                android:layout_height="wrap_content" />-->

            <!--  <com.pacifyr.client.customview.MainTextView
                  android:layout_width="wrap_content"
                  android:id="@+id/read_ctxv"
                  android:layout_height="wrap_content"
                  android:layout_toRightOf="@id/checkBox"
                  android:layout_marginTop="10dp"
                  android:textColor="@color/black"
                  android:layout_below="@+id/year_edt"
                  android:textSize="12dp"
                  android:text="@string/read_understand"/>-->

            <!-- <com.pacifyr.client.customview.MainTextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_toRightOf="@id/checkBox"
                 android:id="@+id/terms_of_use"
                 android:layout_below="@+id/l1"
                 android:textSize="10dp"
                 android:textCursorDrawable="@color/om_blue"
                 android:layout_marginTop="20dp"
                 android:text="@string/register_terms_text"/>


             -->



        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/hint_llay"
            android:id="@+id/next_llay"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:gravity="center_horizontal"
            app:layout_marginBottomPercent="5%"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/next_rlay"
                android:layout_width="match_parent"
                android:layout_marginTop="15dp"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_round_square"
                android:padding="10dp">

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/next_ctxv"
                    android:textSize="20sp"
                    android:textColor="@color/white" />


            </RelativeLayout>

        </LinearLayout>


    </androidx.percentlayout.widget.PercentRelativeLayout>
</ScrollView>

</LinearLayout>