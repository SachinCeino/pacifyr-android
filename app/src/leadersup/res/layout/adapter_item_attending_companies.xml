<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:orientation="horizontal"
    android:background="@drawable/primary_color_solid_round_corner"
    android:gravity="center_vertical">


    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:id="@+id/img_company_logo"
        android:src="@drawable/ic_error_white"
        android:padding="5dp" />
    <com.pacifyr.omhealthcare.events.views.EventTextViewMedium
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtv_title"
        android:lines="1"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/event_sub_title_size_in_detail"
        android:padding="3dp" />

</LinearLayout>
