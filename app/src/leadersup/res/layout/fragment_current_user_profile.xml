            <androidx.cardview.widget.CardView
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                card_view:cardCornerRadius="5dp"
                card_view:contentPadding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="@color/grey_dark_text"
                        android:text="Region" />


                    <com.pacifyr.omhealthcare.customview.MainTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:id="@+id/tv_regione"
                        android:layout_centerHorizontal="true"
                        android:textColor="@color/grey_dark_text"
                        android:layout_marginTop="3dp"
                        android:text=""/>


                </LinearLayout>

            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/LL_view_more"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp">

                <androidx.cardview.widget.CardView

                    card_view:cardCornerRadius="5dp"
                    card_view:contentPadding="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="Race or ethnicity" />


                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:id="@+id/tv_ethnicity"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/grey_dark_text"
                            android:layout_marginTop="3dp"
                            android:text=""/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView

                    card_view:cardCornerRadius="5dp"
                    card_view:contentPadding="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="Education status" />


                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:id="@+id/tv_edustatus"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/grey_dark_text"
                            android:layout_marginTop="3dp"
                            android:text=""/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView

                    card_view:cardCornerRadius="5dp"
                    card_view:contentPadding="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="Services which you referred" />


                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:id="@+id/tv_services"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/grey_dark_text"
                            android:layout_marginTop="3dp"
                            android:text=""/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView

                    card_view:cardCornerRadius="5dp"
                    card_view:contentPadding="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="Organization" />


                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:id="@+id/tv_organization"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/grey_dark_text"
                            android:layout_marginTop="3dp"
                            android:text=""/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView

                    card_view:cardCornerRadius="5dp"
                    card_view:contentPadding="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:orientation="vertical">

                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/grey_dark_text"
                            android:text="School name" />


                        <com.pacifyr.omhealthcare.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:id="@+id/tv_schoolname"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/grey_dark_text"
                            android:layout_marginTop="3dp"
                            android:text=""/>


                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>






        </LinearLayout>
    </ScrollView>

</RelativeLayout>
