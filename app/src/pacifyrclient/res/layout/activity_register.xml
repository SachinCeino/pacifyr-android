<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <include layout="@layout/actionbar_grey"
        android:id="@+id/include"
        android:layout_height="50dp"
        android:layout_width="match_parent">
    </include>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.percentlayout.widget.PercentRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/logo_rlay"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/upload_layout"
                android:gravity="center">
                <ImageView
                    android:layout_width="150dp"
                    android:src="@drawable/powered_logo"
                    android:layout_height="150dp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/logo_blue"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@+id/logo_blue"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    >
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:id="@+id/profile_cimv"
                        android:layout_gravity="center"
                        android:background="@color/grey"/>

                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@android:color/transparent"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorPrimary"
                            android:gravity="center"
                            android:background="@null"
                            android:textSize="12sp"
                            android:id="@+id/add_photo_textView"
                            android:text="Add\nPhoto" />
                    </RelativeLayout>

                </RelativeLayout>


                <TextView
                    android:id="@+id/upload_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:text="Add photo"
                    android:textColor="@color/colorPrimary"

                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/mandatory_fields"
                    android:drawableLeft="@drawable/red_star"
                    android:drawableStart="@drawable/red_star"
                    ></TextView>
            </LinearLayout>

        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/hint_llay"
            android:layout_below="@+id/logo_rlay"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            app:layout_marginTopPercent="10%"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/name_edt"
                android:inputType="textCapSentences|textMultiLine"
                android:textSize="@dimen/sp16"
                android:theme="@style/OMEditTheme"
                android:textCursorDrawable="@color/om_blue"
                android:gravity="left"
                android:drawableLeft="@drawable/red_star"
                android:drawableStart="@drawable/red_star"
                android:textColor="@color/medium_grey_pacifyr"
                android:hint="@string/prompt_name"/>

            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:id="@+id/email_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:gravity="left"
                android:theme="@style/OMEditTheme"
                android:layout_below="@+id/name_edt"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/sp16"
                android:hint="@string/prompt_email"
                android:drawableLeft="@drawable/red_star"
                android:drawableStart="@drawable/red_star"
                android:textColor="@color/medium_grey_pacifyr"
                android:layout_height="wrap_content" />


            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:id="@+id/phone_edt"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:gravity="left"
                android:theme="@style/OMEditTheme"
                android:visibility="visible"
                android:inputType="phone"
                android:drawableLeft="@drawable/red_star"
                android:drawableStart="@drawable/red_star"
                android:layout_below="@+id/email_edt"
                android:clickable="false"
                android:textColor="@color/grey_dark_text"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:id="@+id/phone_llay"
                android:visibility="gone"
                android:layout_below="@+id/phone_edt"
                android:layout_height="wrap_content">

                <!--<com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/textView"
                    android:layout_alignLeft="@+id/textView"/>


                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/phone_cedit"
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:textSize="@dimen/sp17"
                    android:maxLength="10"
                    android:theme="@style/OMEditTheme"
                    android:background="@null"
                    android:textCursorDrawable="@color/om_blue"
                    android:maxLines="1"
                    android:drawableLeft="@drawable/red_star"
                    android:drawableStart="@drawable/red_star"
                    android:hint="@string/phone"
                    android:textColorHint="@color/phone_grey"
                    android:layout_height="40dp" />

            </LinearLayout>


            <com.pacifyrapp.utilitylibrary.CustomEditText
                android:id="@+id/year_edt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/phone_llay"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_marginTop="20dp"
                android:layout_toStartOf="@+id/year_edt_err"
                android:layout_toLeftOf="@+id/year_edt_err"
                android:background="@null"
                android:drawableStart="@drawable/red_star"
                android:drawableLeft="@drawable/red_star"
                android:focusable="false"
                android:gravity="left"
                android:hint="Year of birth"
                android:padding="10dp"
                android:textColor="@color/medium_grey_pacifyr"
                android:textCursorDrawable="@color/om_blue" />
            <EditText
                android:id="@+id/year_edt_err"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:layout_marginTop="20dp"
                android:cursorVisible="false"
                android:layout_below="@+id/phone_llay"
                android:layout_alignParentEnd="true"
                android:textColor="@color/white"
                android:layout_alignParentRight="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/year_edt"
                android:id="@+id/uploadDocLayout"
                android:visibility="gone"
                android:orientation="vertical">
                <EditText
                    android:id="@+id/upload_docs_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@null"
                    android:drawablePadding="3dp"
                    android:hint="Upload KYC documents"
                    android:textColor="@color/black"
                    android:padding="5dp"
                    android:textSize="18sp"
                    android:focusable="false"
                     />

                <View
                    android:id="@+id/upload_view"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/signup_view"
                   />


                <TextView
                    android:id="@+id/upload_instruction_txv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/upload_docs_ctxv"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/document_upload_instruction"
                    android:textSize="8sp"
                    tools:ignore="RtlCompat" />

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/file_list_rcv"
                    android:layout_marginTop="24dp"
                  />

            </LinearLayout>

            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/submit_ctxv"
                android:layout_below="@+id/uploadDocLayout"
                android:id="@+id/terms_of_use_cbox_layout"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                >

                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:background="@null"
                    android:textSize="13sp"
                    android:textColorLink="@color/colorPrimary"
                    />

                <EditText
                    android:id="@+id/terms_of_use_cbox_err"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:ems="1"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="right|top"
                    android:gravity="right|top"
                    android:textColor="@color/white"
                    android:lines="1"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:maxLines="1"
                    />

            </RelativeLayout>



            <!--  <com.pacifyr.client.customview.MainTextView
                  android:layout_width="wrap_content"
                  android:id="@+id/read_ctxv"
                  android:layout_height="wrap_content"
                  android:layout_toRightOf="@id/checkBox"
                  android:layout_marginTop="10dp"
                  android:textColor="@color/black"
                  android:layout_below="@+id/year_edt"
                  android:textSize="12dp"
                  android:text="@string/read_understand"/>-->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </LinearLayout>



        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/hint_llay"
            android:id="@+id/next_llay"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:gravity="center_horizontal"
            app:layout_marginBottomPercent="5%"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_gravity="center"
                android:id="@+id/next_rlay"
                android:layout_width="match_parent"
                android:layout_marginTop="15dp"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_round_square"
                android:padding="10dp">

                <com.pacifyr.client.customview.MainTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sign_up"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/next_ctxv"
                    android:textSize="20sp"
                    android:textColor="@color/white" />


            </RelativeLayout>

        </LinearLayout>


    </androidx.percentlayout.widget.PercentRelativeLayout>
</ScrollView>

</LinearLayout>