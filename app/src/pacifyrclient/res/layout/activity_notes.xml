<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_gravity="center"
            android:background="?attr/colorPrimary"
            android:layout_alignParentTop="true"

            android:id="@+id/action_bar"
            android:orientation="horizontal"
            android:theme="@style/AppTheme.PopupOverlay">

            <include layout="@layout/actionbar_three_text_image" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_below="@+id/action_bar"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="match_parent">

            <com.ceino.utilitylibrary.CustomEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="250dp"
                android:background="@drawable/rounded_white"
                android:id="@+id/etv_notes"
                android:padding="5dp"
                android:gravity="top"
                android:textColor="@color/grey_dark"
                app:fontName="@string/avanti_std_bk"
                android:layout_margin="10dp" />

            <com.ceino.utilitylibrary.CustomFontTextView
                android:layout_width="match_parent"
                android:layout_margin="10dp"
                android:id="@+id/submit_notes"
                android:padding="10dp"
                app:fontName="@string/avanti_std_bk"
                android:layout_below="@+id/etv_notes"
                android:gravity="center_horizontal"
                android:background="@drawable/blue_border_lightblue"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </RelativeLayout>
    </RelativeLayout>
</android.support.constraint.ConstraintLayout>