<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentIncomeCall"
    android:background="@color/grey_dark"
    style="@style/MatchParent">

    <LinearLayout
        android:id="@+id/layout_info_about_call"
        style="@style/MatchWidth"
        android:layout_marginTop="250dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/also_in_call_text_left_right_padding"
        android:paddingRight="@dimen/also_in_call_text_left_right_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/user_dimv"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerVertical="true"
                android:layout_marginTop="10dp"
                android:src="@drawable/placeholder_image"
                android:visibility="visible"
                app:aspect_ratio="1"
                app:height_percentage="10"
                app:parameter="aspect_width"
                app:width_percentage="12" />

            <com.pacifyr.client.customview.MainTextView
                android:id="@+id/username_ctxv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginTop="10dp"
                android:layout_toRightOf="@+id/user_dimv"
                android:padding="5dp"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/sp18"
                android:visibility="visible" />


        </LinearLayout>


        <Chronometer
            android:id="@+id/chronometer_timer_audio_call"
            style="@style/WrapContent"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_common"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/text_remaining_minutes"
            style="@style/WrapContent"
            android:layout_marginTop="5dp"
            android:textColor="@color/blue_button_primary"
            android:textSize="@dimen/also_on_call_text_size" />

        <TextView
            android:id="@+id/text_also_on_call"
            style="@style/WrapContent"
            android:layout_marginTop="24dp"
            android:text="@string/also_on_call"
            android:textColor="@color/text_color_also_on_call"
            android:textSize="@dimen/also_on_call_text_size"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/text_other_inc_users"
            style="@style/WrapContent"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_color_other_inc_users"
            android:textSize="@dimen/other_inc_users_text_size"
            android:visibility="gone"
            tools:text="@string/user_list_on_call" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/info_overlay_llay"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="5dp"
        android:layout_height="wrap_content">

        <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:padding="8dp"
            android:background="@color/transparent"
            android:id="@+id/user_rlay"
            android:layout_alignParentLeft="true"
            android:layout_height="wrap_content">

            <com.pacifyr.client.customview.MainTextView
                android:layout_width="wrap_content"
                android:id="@+id/call_ctxv"
                android:visibility="visible"
                android:textSize="@dimen/sp18"
                android:singleLine="true"
                android:textStyle="bold"
                android:text="@string/audio_call"
                android:textColor="@color/grey_fit"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/connectionStatusLocal"
                style="@style/WrapContent"
                android:layout_below="@+id/call_ctxv"
                android:layout_marginBottom="@dimen/margin_very_small"
                android:layout_marginTop="5dp"
                android:maxLength="13"
                android:maxLines="1"
                android:text="Ringing..."
                android:visibility="gone"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/blue_button_primary"
                android:textStyle="normal" />



        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="5dp"
                android:padding="5dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@color/grey_dark"
                android:id="@+id/emotion_rlay"
                android:visibility="gone"
                android:layout_height="wrap_content">

                <com.pacifyrapp.utilitylibrary.DeviceFitImageView
                    android:layout_width="wrap_content"
                    android:id="@+id/emotion_dimv"
                    app:width_percentage="15"
                    android:layout_marginLeft="5dp"
                    android:visibility="visible"
                    app:height_percentage="12"
                    android:layout_centerHorizontal="true"
                    app:parameter="aspect_width"
                    app:aspect_ratio="1"
                    android:src="@drawable/placeholder_user"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    android:layout_below="@+id/emotion_dimv"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.pacifyr.client.customview.MainTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:singleLine="true"
                            android:text="Emotion : "
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp13"
                            android:textStyle="bold"
                            android:visibility="visible" />

                        <com.pacifyr.client.customview.MainTextView
                            android:id="@+id/emotion_ctxv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/sp13"
                            android:textStyle="bold"
                            android:text=""
                            android:visibility="visible" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.pacifyr.client.customview.MainTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:singleLine="true"
                                android:text="Cause : "
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp13"
                                android:textStyle="bold"
                                android:visibility="visible" />

                            <com.pacifyr.client.customview.MainTextView
                                android:id="@+id/reason_ctxv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:singleLine="true"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/sp13"
                                android:textStyle="bold"
                                android:visibility="visible" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>


        </RelativeLayout>
    </LinearLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:id="@+id/call_overlay_frame"
        android:padding="10dp"
        android:layout_margin="8dp"
        >

        <ImageView
            android:id="@+id/toggle_Max_Min"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end"
            android:src="@drawable/overlay_max_min"></ImageView>

        <LinearLayout
            android:id="@+id/call_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/toggle_Max_Min"
            android:layout_marginTop="50dp"
            android:background="@drawable/call_overlay_background"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_emotion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/confused" />
            </LinearLayout>

            <!--
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:id="@+id/ImageView_note"
                            android:padding="5dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/overlay_note" />
                        </LinearLayout>
            -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/more_rlay"
                android:padding="5dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_more" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/certificate_View"
                android:visibility="gone"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_kyc"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_kyc" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/LinearLayout_chat"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_chat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_chat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/LinearLayout_prescription"
                android:padding="5dp">

                <ImageView
                    android:id="@+id/ImageView_prescription"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/overlay_prescription" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>


    <include
        layout="@layout/view_outgoing_screen"
        android:visibility="gone" />

    <include
        android:id="@+id/call_layout"
        layout="@layout/view_audio_action_buttons_conversation_fragment" />

    <com.pacifyr.client.customview.MainTextView
        android:id="@+id/billing_status"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="13dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/white_border_transparent_black"
        android:enabled="false"
        android:padding="10dp"
        android:text="@string/start_session"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:visibility="invisible" />

</RelativeLayout>