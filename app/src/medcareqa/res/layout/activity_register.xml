<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include android:id="@+id/include"
        layout="@layout/actionbar_grey"
        android:layout_width="match_parent"
        android:layout_height="50dp">
    </include>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.percentlayout.widget.PercentRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <RelativeLayout
            android:id="@+id/logo_rlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            >
            <LinearLayout
                android:id="@+id/upload_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/logo_blue"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/powered_logo"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/logo_blue"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    >
                    <ImageView
                        android:id="@+id/profile_cimv"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:background="@color/grey"/>

                    <RelativeLayout
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@android:color/transparent"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/add_photo_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="center"
                            android:text="Add\nPhoto"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp" />
                    </RelativeLayout>

                </RelativeLayout>


                <TextView
                    android:id="@+id/upload_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Add photo"
                    android:textColor="@color/colorPrimary"
                    android:visibility="gone"

                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:drawableStart="@drawable/red_star"
                    android:drawableLeft="@drawable/red_star"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/mandatory_fields"
                    android:textColor="@color/colorPrimary"
                    ></TextView>
            </LinearLayout>

        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/hint_llay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/logo_rlay"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="25dp"
            android:layout_marginRight="35dp"
            android:gravity="center"
            android:orientation="vertical">

           <LinearLayout
               android:id="@+id/LinearLayout_Name"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <com.pacifyrapp.utilitylibrary.CustomEditText
                   android:id="@+id/name_edt"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:background="@drawable/edittext_black_curve"
                   android:drawableStart="@drawable/red_star"
                   android:drawableLeft="@drawable/red_star"
                   android:gravity="center_vertical"
                   android:hint="@string/prompt_name"
                   android:inputType="textCapWords"
                   android:minHeight="40dp"
                   android:textColor="@color/medium_grey_pacifyr"
                   android:textSize="@dimen/sp16"/>

               <TextView
                   android:id="@+id/TextView_Name_Error"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="2dp"
                   android:text=""
                   android:textColor="@color/red"
                   android:textSize="12sp"
                   android:visibility="gone"></TextView>


           </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayout_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/LinearLayout_Name"
                android:layout_marginTop="10dp"
                android:orientation="vertical">
                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/email_edt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_black_curve"
                    android:drawableStart="@drawable/red_star"
                    android:drawableLeft="@drawable/red_star"
                    android:gravity="center_vertical"
                    android:hint="@string/prompt_email"
                    android:inputType="textEmailAddress"
                    android:minHeight="40dp"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:textSize="@dimen/sp16"
                    />
                <TextView
                    android:id="@+id/TextView_Email_Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text=""
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"></TextView>

            </LinearLayout>



           <LinearLayout
               android:id="@+id/LinearLayout_phone"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@+id/LinearLayout_email"
               android:layout_marginTop="10dp"
               android:orientation="vertical">
               <com.pacifyr.client.customview.MainTextView
                   android:id="@+id/phone_edt"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:background="@drawable/edittext_black_curve"
                   android:clickable="false"
                   android:drawableStart="@drawable/red_star"
                   android:drawableLeft="@drawable/red_star"
                   android:gravity="center_vertical"
                   android:inputType="phone"
                   android:minHeight="40dp"
                   android:textColor="@color/grey_dark_text"
                   android:theme="@style/OMEditTheme"
                   android:visibility="visible"
                   />
               <TextView
                   android:id="@+id/TextView_Phone_Error"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="2dp"
                   android:text=""
                   android:textColor="@color/red"
                   android:textSize="12sp"
                   android:visibility="gone"></TextView>
           </LinearLayout>

            <LinearLayout
                android:id="@+id/phone_llay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/LinearLayout_phone"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.pacifyrapp.utilitylibrary.CustomEditText
                        android:id="@+id/phone_cedit"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edittext_black_curve"
                        android:drawableStart="@drawable/red_star"
                        android:drawableLeft="@drawable/red_star"
                        android:gravity="center_vertical"
                        android:hint="@string/phone"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:textColorHint="@color/phone_grey"
                        android:textCursorDrawable="@color/om_blue"
                        android:textSize="@dimen/sp17"
                        android:theme="@style/OMEditTheme" />
                    <TextView
                        android:id="@+id/TextView_Phonelay_Error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="2dp"
                        android:text=""
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone"></TextView>
                </LinearLayout>

            </LinearLayout>


           <LinearLayout
               android:id="@+id/LinearLayout_year"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_below="@+id/phone_llay"
               android:layout_marginTop="10dp"
               android:orientation="vertical">
               <com.pacifyrapp.utilitylibrary.CustomEditText
                   android:id="@+id/year_edt"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_below="@+id/phone_llay"
                   android:background="@drawable/edittext_black_curve"
                   android:drawableStart="@drawable/red_star"
                   android:drawableLeft="@drawable/red_star"
                   android:focusable="false"
                   android:gravity="center_vertical"
                   android:hint="Enter Date of birth"
                   android:minHeight="40dp"
                   android:padding="10dp"
                   android:textColor="@color/medium_grey_pacifyr"
                   android:textCursorDrawable="@color/om_blue" />
               <TextView
                   android:id="@+id/TextView_Year_Error"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:layout_margin="2dp"
                   android:text=""
                   android:textColor="@color/red"
                   android:textSize="12sp"
                   android:visibility="gone"></TextView>
           </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayout_EmployeeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/LinearLayout_year"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/employeeid_edt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_black_curve"
                    android:gravity="center_vertical"
                    android:hint="@string/med_record_id"
                    android:inputType="textCapWords"
                    android:drawableStart="@drawable/red_star"
                    android:drawableLeft="@drawable/red_star"
                    android:minHeight="40dp"
                    android:textColor="@color/medium_grey_pacifyr"
                    android:textSize="@dimen/sp16" />

                <TextView
                    android:id="@+id/TextView_employeeId_Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:text=""
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"></TextView>


            </LinearLayout>


            <LinearLayout
                android:id="@+id/uploadDocLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/LinearLayout_EmployeeId"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/RelativeLayout_UploadDoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_black_curve"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/upload_docs_ctxv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:drawablePadding="3dp"
                        android:focusable="false"
                        android:hint="@string/upload_kyc_documents"
                        android:padding="5dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="18sp" />

                    <com.pacifyr.client.customview.MainTextView
                        android:id="@+id/TextView_Upload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="10dp"
                        android:gravity="center_horizontal"
                        android:padding="5dp"
                        android:text="@string/upload"
                        android:textColor="@color/colorPrimary"></com.pacifyr.client.customview.MainTextView>
                </RelativeLayout>

                <TextView
                    android:id="@+id/upload_instruction_txv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/RelativeLayout_UploadDoc"
                    android:layout_marginEnd="8dp"
                    android:text="@string/document_upload_instruction"
                    android:textSize="8sp"
                    tools:ignore="RtlCompat" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/file_list_rcv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/upload_instruction_txv"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layout_states"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/uploadDocLayout"
                android:layout_marginTop="15dp"
                android:background="@drawable/edittext_black_curve"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:padding="3dp"
                android:visibility="gone"
                >

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/selected_states_txtv"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:gravity="center_vertical"
                    android:hint="@string/State_you_are_licensed_to_practise"
                    android:paddingLeft="3dp"
                    android:textColorHint="@color/black" />

                <com.pacifyrapp.utilitylibrary.CustomEditText
                    android:id="@+id/selected_states_txtv_err"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="15dp"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:ems="1"
                    android:gravity="end"
                    android:lines="1"
                    android:maxLines="1"
                    android:textColor="@color/white" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentRight="true"
                    android:foregroundGravity="center"
                    android:padding="5dp"
                    android:src="@drawable/right_arrow2"
                    app:tint="@color/black" />

            </RelativeLayout>

            <com.pacifyr.client.customview.MainTextView
                android:id="@+id/TextView_states_Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_states"
                android:layout_margin="2dp"
                android:text="ffbfb"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                ></com.pacifyr.client.customview.MainTextView>


            <RelativeLayout
                android:id="@+id/terms_of_use_cbox_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/submit_ctxv"
                android:layout_below="@+id/TextView_states_Error"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                >

                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:text=""
                    android:textColorLink="@color/colorPrimary"
                    android:textSize="13sp"
                    />

                <TextView
                    android:id="@+id/TextView_terms_Error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/checkBox"
                    android:layout_margin="2dp"
                    android:text=""
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    ></TextView>

            </RelativeLayout>



            <!--  <com.pacifyr.client.customview.MainTextView
                  android:layout_width="wrap_content"
                  android:id="@+id/read_ctxv"
                  android:layout_height="wrap_content"
                  android:layout_toRightOf="@id/checkBox"
                  android:layout_marginTop="10dp"
                  android:textColor="@color/black"
                  android:layout_below="@+id/year_edt"
                  android:textSize="12dp"
                  android:text="@string/read_understand"/>-->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </LinearLayout>



        </RelativeLayout>

        <LinearLayout
            android:id="@+id/next_llay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/hint_llay"
            android:layout_marginLeft="35dp"
            android:layout_marginRight="35dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_marginBottomPercent="5%">

            <RelativeLayout
                android:id="@+id/next_rlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/blue_round_square"
                android:padding="10dp">

                <com.pacifyr.client.customview.MainTextView
                    android:id="@+id/next_ctxv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:text="@string/sign_up"
                    android:textColor="@color/white"
                    android:textSize="20sp" />


            </RelativeLayout>

        </LinearLayout>


    </androidx.percentlayout.widget.PercentRelativeLayout>
</ScrollView>

</LinearLayout>